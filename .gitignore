# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# Downloaded source files: fetched at build time, verified by checksum, never committed
# (sources that may not be redistributed must never enter the repository; see LICENSE-CONTENT.md)
data/packages/*/*/source/
data/cache/
# X-COP v2 tables: built locally and in CI, never committed or pushed until the authors confirm
# (D-090 rule 5; REPRODUCTION_PART_B.md rule 5). checksums.sha256 is committed instead.
data/packages/aeg-d-xcop/v2/tables/

# Site build output
site/dist/
site/node_modules/
site/.astro/

# OS and editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets: never commit credentials or tokens
.env
.env.*
