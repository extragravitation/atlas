      <div tabindex="0" class="tablebox" style="max-height:none"><table>
        <thead><tr><th class="l">Technical</th><th class="l">Plain language</th></tr></thead>
        <tbody>
          <tr><td class="l">g_obs, observed acceleration</td><td class="l">observed pull</td></tr>
          <tr><td class="l">g_bar, baryonic acceleration (Newtonian, detected baryons)</td><td class="l">pull from detected matter</td></tr>
          <tr><td class="l">g_obs / g_bar, acceleration discrepancy</td><td class="l">extra pull</td></tr>
          <tr><td class="l">dynamics</td><td class="l">motions</td></tr>
          <tr><td class="l">gravitational lensing</td><td class="l">light-bending</td></tr>
        </tbody>
      </table></div>
