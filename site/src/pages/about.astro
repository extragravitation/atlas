---
import Base from '../layouts/Base.astro';
import L from '../components/L.astro';
import Layer from '../components/Layer.astro';
import fs from 'node:fs';
import path from 'node:path';
import { loadAtlas, ROOT } from '../lib/atlas.mjs';
import { datasetCount, datasetNames } from '../lib/labels.mjs';
import { md } from '../lib/md.mjs';
const atlas = loadAtlas();
const nDs = datasetCount(atlas.datasets), dsNames = datasetNames(atlas.datasets), dsNamesP = datasetNames(atlas.datasets, 'p');
const base = import.meta.env.BASE_URL;
const REPO = 'https://github.com/extragravitation/atlas';
// The last tagged release, read from CITATION.cff (D-010, D-077).
const cff = fs.readFileSync(path.join(ROOT, 'CITATION.cff'), 'utf8');
const relVersion = (cff.match(/^version:\s*"?([^"\n]+)"?/m) || [])[1] || '';
const relDate = (cff.match(/^date-released:\s*"?([^"\n]+)"?/m) || [])[1] || '';
const nRepro = atlas.all.filter((d) => d.md.reproduction).length;
// Related compilations (read at source 2026-11-06 UTC; record: docs/sources/related-compilations.md).
const ax = (id) => `https://arxiv.org/abs/${id}`;
const related = [
  ['Several kinds of system on one plot', [
    ['Lelli, McGaugh, Schombert & Pawlowski 2017, ApJ 836, 152', '1610.08981', 'disc galaxies, early-type galaxies and 62 dwarf spheroidals on one radial acceleration relation (240 galaxies).'],
    ['Lelli et al. 2024, invited review, IAU General Assembly', '2411.02499', 'galaxies from gas kinematics to weak lensing, plus the Solar System, about 16 orders of magnitude in g_bar.'],
    ['Tian et al. 2024, A&A 684, A180', '2402.12016', 'the brightest cluster galaxies (dynamics) and their clusters (lensing) on one acceleration plot.'],
    ['McGaugh et al. 2026, ApJ (accepted)', '2603.06479', 'baryonic against dynamical mass from galaxies to clusters, from dynamics and lensing; a mass plot, not a radial acceleration plot.'],
  ]],
  ['The relation taken to one new kind of system', [
    ['McGaugh, Lelli & Schombert 2016, PRL 117, 201101', '1609.05917', 'disc galaxies (SPARC): 2 693 points in 153 galaxies.'],
    ['Brouwer et al. 2021, A&A 650, A113', '2106.11677', 'weak lensing around isolated galaxies (KiDS-1000), two decades lower in acceleration.'],
    ['Mistele et al. 2024, JCAP 04, 020', '2310.15248', 'weak lensing joined to kinematics, to large radii.'],
    ['Chae et al. 2020, ApJL 903, L31', '2010.10779', 'elliptical galaxies, from velocity-dispersion profiles.'],
    ['Tian et al. 2020, ApJ 896, 70', '2001.08340', 'galaxy clusters from lensing and X-rays (20 CLASH clusters).'],
    ['Eckert et al. 2022, A&A 662, A123', '2205.01110', 'galaxy clusters from X-ray and SZ hydrostatics (X-COP), with gas, central galaxy and member galaxies separated.'],
    ['Li et al. 2023, A&A 677, A24', '2303.10175', 'galaxy clusters from the motions of their member galaxies.'],
    ['Mistele et al. 2025, Open Journal of Astrophysics', '2506.13716', 'galaxy clusters from non-parametric weak lensing; the result depends strongly on how the gas mass is extrapolated.'],
    ['Scarpa et al. 2007, ESO Messenger 128, 41', '0707.2459', 'globular clusters: dispersion profiles at low acceleration (not plotted as g_obs against g_bar).'],
  ]],
  ['Open databases', [
    ['Lelli, McGaugh & Schombert 2016, AJ 152, 157 (SPARC)', '1606.09251', '175 disc galaxies, mass models; a source of this Atlas.'],
    ['Baumgardt & Hilker 2018, MNRAS 478, 1520; Hilker et al. 2019', '1804.08359', 'Milky Way globular clusters, maintained online; a source of this Atlas.'],
    ['Pace 2025, Open Journal of Astrophysics (Local Volume Database)', '2411.07424', 'dwarf galaxies and star clusters, versioned; the index of this Atlas’s dwarfs.'],
    ['Ettori et al. 2019, A&A 621, A39 (X-COP)', '1805.00035', 'hydrostatic mass profiles of X-COP clusters, with public data products; a source of this Atlas.'],
  ]],
  ['Reviews', [
    ['Famaey & McGaugh 2012, Living Reviews in Relativity 15, 10', '1112.3960', 'observations at all scales, organised around one account of the discrepancy.'],
    ['Desmond 2025, Moriond proceedings', '2505.21638', 'successes and failures of one account across scales.'],
  ]],
];
const toc = [['status', 'What this is'], ['charter', 'Charter'], ['related', 'Related compilations'], ['authorship', 'Authorship and AI assistance'], ['interests', 'Competing interests'], ['review', 'Review status'], ['privacy', 'Privacy and analytics'], ['cite', 'How to cite'], ['report', 'Report an error'], ['corrections', 'Corrections'], ['licences', 'Licences']];
---
<Base title="About" active="about">
  <div class="doc">
    <main class="prose">
      <p class="kicker">About</p>
      <h1><L t="About the Atlas" p="About this Atlas" /></h1>
      <Layer as="p" class="lede"><Fragment slot="t">An open atlas of the acceleration discrepancy: where and how the observed gravitational acceleration exceeds what Newtonian gravity predicts from detected baryonic matter, across every kind of system where the two can be compared. It is cause-agnostic and reference-explicit: it takes no side on the cause, and states its reference calculation openly. It describes the observations as carefully as possible, so that they can serve as the test any account of them must pass.</Fragment><Fragment slot="p">This Atlas maps where, and by how much, things are pulled harder than Newton’s gravity from the detected matter would pull them, in every kind of object where the two can be compared. It says openly what it compares with, and it takes no side on why they differ.</Fragment></Layer>

      <h2 id="status"><L t="What this is: a preliminary pre-release" p="An early version" /></h2>
      <p><L t={`The site shows the Atlas as it now stands: ${nDs} (${dsNames}), each in its latest version, with earlier versions kept unchanged on their dataset pages. The last tagged release is ${relVersion} (${relDate}), preliminary and not peer reviewed (D-077); work since then is listed below as unreleased. The first public release, v1.0, will cover every kind of system in the taxonomy (D-028). Until then the site is not indexed by search engines, has not been reviewed outside the project, and may change without notice; released data will never be overwritten.`} p={`The site shows the Atlas as it is now: ${nDs} (${dsNamesP}). The last numbered version came out on ${relDate}; later changes are listed below. The full first release will cover every kind of object. Until then nobody outside the project has checked it, and it may change. Data we have released are never changed afterwards.`} /> <a href={`${base}coverage/`}>Coverage</a> · <a href={`${base}for-data-providers/`}><L t="For data providers" p="For data providers" /></a></p>

      <h2 id="charter">Charter</h2>
      <ul>
        <li><L t="Describe observations; never assume a cause. State the reference calculation openly, and keep the observations so any account can be checked against them." p="We describe what is measured, say what we compare it with, and do not say what causes the difference." /></li>
        <li><L t="Baseline: Newtonian gravity acting on detected baryonic matter. Dynamics and lensing are separate channels, never merged by default." p="We compare with Newton’s gravity from the matter we detect, and keep motions and light-bending apart." /></li>
        <li><L t="Every number traces to a published source, with citation, licence, method, assumptions, units and file hash." p="Every number comes from a published study, and you can check it." /></li>
        <li><L t="Labels never carry the result; continuous properties stay continuous." p="No name or group we use contains the answer, and smooth properties stay as numbers instead of being split into groups." /></li>
        <li><L t="Assumptions are shown with their published ranges; their effects are computed from the data." p="We show our assumptions and let you change them within published limits." /></li>
        <li><L t="Uncertainties and gaps are shown openly; corrections are logged publicly." p="We show what we are unsure of and what is missing, and we log our corrections." /></li>
        <li><L t="Tests and predictions are frozen by hash before data are seen; results are posted whether they pass or fail." p="Tests are locked before we look, and we publish every result." /></li>
      </ul>
      <p class="small"><L t="Decisions that change what the Atlas says or how it measures are recorded, with reasons, in the" p="Every decision is written down, with the reason, in the" /> <a href={`${REPO}/blob/main/docs/decisions.md`}>decision log</a>.</p>

      <h2 id="related"><L t="Related compilations" p="Who else has done this" /></h2>
      <Layer as="p"><Fragment slot="t">Earlier work has put several kinds of system on the same g_obs–g_bar plot, or extended it to a new kind of system, and the field relies on several open databases. Most of these are figures in papers rather than released tables, and several are organised around testing one account. The Atlas builds on them. What it adds is one open, versioned table across these scales, with dynamics and lensing kept separate, each value traced to its source, the assumptions shown, and a public audit. In a search on 2026-11-06 (UTC) we found no earlier work that puts globular clusters, dwarf galaxies, disc galaxies, galaxy lensing and galaxy clusters on one g_obs–g_bar plot. We would welcome being pointed to one.</Fragment><Fragment slot="p">Others have compared these two pulls before, for one kind of system at a time, or for a few kinds together in a paper. Some built the open data collections the Atlas draws on. What the Atlas adds is one open table that covers everything from star clusters to clusters of galaxies, with every number traced back to its paper and nothing assumed about the cause. If we have missed earlier work like this, please tell us.</Fragment></Layer>
      {related.map(([head, items]) => <>
        <h3 style="font-size:17px">{head}</h3>
        <ul class="small">{items.map(([cite, id, what]) => <li><a href={ax(id)}>{cite}</a>: {what}</li>)}</ul>
      </>)}
      <p class="small"><L t="Each item was read at source on 2026-11-06 UTC (arXiv abstract pages); the record, with quotes, is" p="Where these come from:" /> <a href={`${REPO}/blob/main/docs/sources/related-compilations.md`}>docs/sources/related-compilations.md</a>.</p>

      <h2 id="authorship"><L t="Authorship and AI assistance" p="Who made it" /></h2>
      <Layer as="p"><Fragment slot="t">The Atlas’s framework, structure and purpose are John van Hemert’s, who rules on every decision. Coding, research and data compilation use AI assistance (Claude, by Anthropic), under his direction and rulings. Every change is a reviewed pull request in the public repository.</Fragment><Fragment slot="p">John van Hemert designed the Atlas and decides every question about it. The coding, the research and the data work are done with an AI assistant (Claude, made by Anthropic), under his direction. Every change is public and checked before it goes in.</Fragment></Layer>

      <h2 id="interests"><L t="Competing interests" p="Interests" /></h2>
      <p><L t="The maintainer also works independently on theoretical physics, including questions related to the acceleration discrepancy. None of that work is used in the Atlas, by rule, and the Atlas takes no side between the accounts of the discrepancy (D-078). The maintainer has no financial interests in this work." p="The person who runs the Atlas also does his own theoretical physics, including on the extra pull itself. None of it is used here, by rule, and the Atlas takes no side (D-078). He has no money riding on this work." /></p>

      <h2 id="review"><L t="Review status" p="Has anyone checked it?" /></h2>
      <p><L t="Not yet externally reviewed. An outside reader will review the complete v1.0 for neutrality before it is published (D-011, D-032), and advisers from different interpretive positions will be approached. Their names and findings will be posted here. Internal reviews made with AI assistance are labelled as such and are not presented as outside review." p="Not yet by anyone outside the project. Before the full first release is published, one outside reader will check it for neutrality, and advisers with different views on the cause will be asked to help. Their names and what they find will be posted here. Our own checks, made with AI help, are labelled as such." /></p>
      <p class="small"><L t={`Each of the ${nRepro} published dataset versions has a reproduction test, frozen by hash before the data were converted, with its result on the Reproduction page, pass or fail.`} p="Each dataset was tested against the original study’s own numbers, with the test locked in advance." /> <a href={`${base}reproduction/`}><L t="Reproduction" p="See the checks" /></a></p>
      <p class="small"><L t="The frozen independent audit (D-082) ran on 2026-11-05, with AI readers. It found no wrong value among 254 sampled measurements, and it does not pass because of gaps in the written methods, the provenance records and some wording. See the" p="An audit with AI readers found no wrong numbers in a random sample, but found gaps in how we wrote things down. See the" /> <a href={`${base}reproduction/#audit`}>audit result</a>.</p>

      <h2 id="privacy"><L t="Privacy and analytics" p="Your privacy" /></h2>
      <p><L t="The site sets no cookies and collects no personal data. Your theme, reading layer and slider settings are kept in your own browser and in the page address only. A cookieless, aggregate page counter (no cookies, no stored IP addresses, no personal data) is planned under D-009; it is not active yet, and this paragraph will say when it is." p="No cookies and no personal data. Your settings stay in your own browser. A simple page counter that stores nothing personal is planned; it is not switched on yet." /></p>

      <h2 id="cite"><L t="How to cite" p="How to cite" /></h2>
      <p><L t="Please cite the version of the Atlas you used, and the original sources of any data you use (each dataset page lists them). Version 0.1 is a preliminary pre-release, not peer reviewed:" p="Please cite the version you used, and the original studies of any data you use. Version 0.1 is an early, unreviewed release:" /></p>
      <p class="boxed" style="font-family:var(--mono);font-size:13px">van Hemert, J. (2026). Atlas of Extra Gravitation, version 0.1 (preliminary, not peer reviewed). Zenodo. https://doi.org/10.5281/zenodo.23864356</p>
      <p class="small">To refer to the Atlas in general, the DOI <a href="https://doi.org/10.5281/zenodo.23864355">10.5281/zenodo.23864355</a> always resolves to the latest version. Each release is archived on Zenodo (D-010, D-077). A <a href={`${REPO}/blob/main/CITATION.cff`}>CITATION.cff</a> is in the repository. Each system page gives a citation for that system.</p>

      <h2 id="report"><L t="Report an error" p="Found a mistake?" /></h2>
      <p><L t="Open an issue in the public repository, with the measurement or system identifier if you can. Problems with the data are tracked on the Known issues page." p="Tell us by opening an issue on GitHub. Problems with the data are listed on the Known issues page." /> <a href={`${REPO}/issues/new`}>Open an issue</a> · <a href={`${base}known-issues/`}>Known issues</a></p>

      <h2 id="corrections"><L t="Corrections" p="Corrections" /></h2>
      <p><L t={`Version ${relVersion.replace(/^v/, '')} (${relDate}) is the only release so far. Errors found since in its data are stated on the affected dataset pages and on Known issues (for example X-COP v1's stellar profiles, D-088), and are corrected by new dataset versions. Each correction will be listed here with the release that ships it; released data are never overwritten.`} p="Only one version has been released so far. Mistakes found in it since are explained on the dataset pages and on the Known issues page, and are fixed in new versions of the data, never by changing what was released." /></p>
      <Layer as="p" class="small"><Fragment slot="t">The changelog below is the repository’s CHANGELOG.md, rendered as written: every change since the last release, with its decision number.</Fragment><Fragment slot="p">The list below records, date by date, everything that has changed since the last release. It is written in technical terms; the decision log gives the reason for each change.</Fragment></Layer>
      <details><summary><L t="Changelog (unreleased work)" p="List of changes (technical)" /></summary><div set:html={md(atlas.changelog)} /></details>

      <h2 id="licences"><L t="Licences" p="Reuse" /></h2>
      <p><L t="Code: MIT. Text, figures and Atlas-produced data tables: CC BY 4.0, except where a source’s terms govern a table; each dataset page states which. Fonts: Source Serif 4, Source Sans 3 and Source Code Pro (SIL Open Font License)." p="You may reuse the code freely, and the text, figures and our tables with credit, unless a source’s own terms apply to a table; each dataset page says which. The fonts are free to use too." /> <a href={`${REPO}/blob/main/LICENSE`}>LICENSE</a> · <a href={`${REPO}/blob/main/LICENSE-CONTENT.md`}>LICENSE-CONTENT.md</a></p>
    </main>
    <aside class="toc"><p class="cap">On this page</p>{toc.map(([id, t]) => <a href={'#' + id}>{t}</a>)}</aside>
  </div>
</Base>
