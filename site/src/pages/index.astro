---
// The front door (D-113 rule 1.4): what the Atlas is, the cross-scale chart at the sources'
// defaults, the release status, and routes onward. The full map is at map/.
// The chart is drawn at build time from the same package rows the map uses; nothing is fitted (D-026).
import Base from '../layouts/Base.astro';
import L from '../components/L.astro';
import { loadAtlas } from '../lib/atlas.mjs';
import { datasetLabel } from '../lib/labels.mjs';
import { REPO } from '../lib/md.mjs';

const base = import.meta.env.BASE_URL;
const atlas = loadAtlas();
const VAR = { 'aeg-d-sparc': 'sparc', 'aeg-d-gc-baumgardt': 'gc', 'aeg-d-dwarfs': 'dw', 'aeg-d-strong-lensing': 'sl', 'aeg-d-xcop': 'xcop', 'aeg-d-kids1000-rar': 'kids' };
const ORDER = ['aeg-d-sparc', 'aeg-d-xcop', 'aeg-d-gc-baumgardt', 'aeg-d-dwarfs', 'aeg-d-kids1000-rar', 'aeg-d-strong-lensing'];

// Points: every plotted row with g_obs, g_bar > 0, at the packaged defaults.
const W = 820, H = 620, ML = 84, MR = 16, MT = 16, MB = 66;
const X0 = -15, X1 = -7.5, Y0 = -13, Y1 = -7.5;
const pw = W - ML - MR, ph = H - MT - MB;
const sx = (v) => ML + ((v - X0) / (X1 - X0)) * pw;
const sy = (v) => MT + ((Y1 - v) / (Y1 - Y0)) * ph;
const f1 = (v) => v.toFixed(1);
let total = 0;
const marks = [];
const dsInfo = [];
const sorted = [...atlas.datasets].sort((a, b) => ORDER.indexOf(a.name) - ORDER.indexOf(b.name));
for (const d of sorted) {
  const rows = d.measurements.rows.filter((r) => r.plotted !== 'false');
  total += rows.length;
  const v = VAR[d.name] || 'sparc';
  const projected = rows.some((r) => r.r_kind === 'projected');
  const stacked = !d.systems;
  for (const r of rows) {
    if (!(r.g_obs > 0 && r.g_bar > 0)) continue;
    const x = Math.log10(r.g_bar), y = Math.log10(r.g_obs);
    if (x < X0 || x > X1 || y < Y0 || y > Y1) continue;
    const X = sx(x), Y = sy(y);
    if (projected) marks.push(`<circle cx="${f1(X)}" cy="${f1(Y)}" r="3.6" fill="none" style="stroke:var(--${v})" stroke-width="1.3"/><circle cx="${f1(X)}" cy="${f1(Y)}" r="1" style="fill:var(--${v})"/>`);
    else if (stacked) marks.push(`<path d="M${f1(X)} ${f1(Y - 4)}L${f1(X + 4)} ${f1(Y)}L${f1(X)} ${f1(Y + 4)}L${f1(X - 4)} ${f1(Y)}Z" fill="none" style="stroke:var(--${v})" stroke-width="1.4"/>`);
    else if (d.name === 'aeg-d-sparc') marks.push(`<circle cx="${f1(X)}" cy="${f1(Y)}" r="1.3" style="fill:var(--${v})" fill-opacity="0.55"/>`);
    else marks.push(`<circle cx="${f1(X)}" cy="${f1(Y)}" r="3" style="fill:var(--${v})" fill-opacity="0.9"/>`);
  }
  const lab = datasetLabel(d.name);
  const nSys = d.systems ? new Set(rows.map((r) => r.system_id)).size : 0;
  const size = d.systems
    ? (rows.length === nSys ? `${nSys} ${lab.units}` : `${nSys} ${lab.units} · ${rows.length.toLocaleString('en')} points`)
    : `${rows.length} ${lab.units}`;
  dsInfo.push({ v, key: d.key, t: lab.kind_t, p: lab.kind_p, name_t: lab.t, name_p: lab.p, size, method_t: lab.method_t, method_p: lab.method_p, shape: projected ? 'ring' : stacked ? 'diamond' : 'dot', href: `${base}datasets/${d.key}/` });
}
const nWords = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'][atlas.datasets.length] || String(atlas.datasets.length);
const grid = [];
for (let v = -15; v <= -8; v++) grid.push(`<line x1="${f1(sx(v))}" y1="${MT}" x2="${f1(sx(v))}" y2="${MT + ph}" style="stroke:var(--grid)"/><text x="${f1(sx(v))}" y="${MT + ph + 8}" text-anchor="middle" dominant-baseline="hanging" class="tick">${v}</text>`);
for (let v = -13; v <= -8; v++) grid.push(`<line x1="${ML}" y1="${f1(sy(v))}" x2="${ML + pw}" y2="${f1(sy(v))}" style="stroke:var(--grid)"/><text x="${ML - 8}" y="${f1(sy(v))}" text-anchor="end" dominant-baseline="central" class="tick">${v}</text>`);
const a = Math.max(X0, Y0), b = Math.min(X1, Y1);
const oneToOne = `<line x1="${f1(sx(a))}" y1="${f1(sy(a))}" x2="${f1(sx(b))}" y2="${f1(sy(b))}" style="stroke:var(--ink)" stroke-width="1.4" stroke-dasharray="6 5" opacity="0.8"/>`;
const ang = (Math.atan2(ph / (Y1 - Y0), pw / (X1 - X0)) * 180) / Math.PI;
const lx = sx(-12.55) + 8, ly = sy(-12.55) + 20;
const svg = `${grid.join('')}${oneToOne}${marks.join('')}`;
const legendShape = (s, v) => s === 'ring' ? `<circle cx="8" cy="8" r="5" fill="none" style="stroke:var(--${v})" stroke-width="1.5"/><circle cx="8" cy="8" r="1.4" style="fill:var(--${v})"/>` : s === 'diamond' ? `<path d="M8 2.5L13.5 8L8 13.5L2.5 8Z" fill="none" style="stroke:var(--${v})" stroke-width="1.5"/>` : `<circle cx="8" cy="8" r="4.5" style="fill:var(--${v})"/>`;
const CONCEPT_DOI = '10.5281/zenodo.23864355';
---
<Base title="" active="home">
  <script is:inline define:vars={{ base }}>
    // Map links shared before the map moved to map/ (D-113) still open the map, with their view.
    (function () {
      var q = new URLSearchParams(location.search), keys = ['view', 'pick', 'errk', 'marks', 'err', 'col', 'hide', 'sel', 'unit', 'eb', 'rng', 'z'];
      if (keys.some(function (k) { return q.has(k); }) || location.hash === '#explore') location.replace(base + 'map/' + location.search + location.hash);
    })();
  </script>
  <div class="front">
    <section class="intro">
      <p class="kicker"><L t="v0.2 · preliminary · not peer reviewed" p="Early version · not yet reviewed by outside experts" /></p>
      <h1 class="headline"><L t="Observed accelerations, compared with the Newtonian prediction from detected baryons" p="How strongly things pull, compared with what their visible matter should give" /></h1>
      <p class="lede"><L t={`${total.toLocaleString('en')} measurements from ${nWords} published datasets, from star clusters to galaxy clusters. Each point sets the acceleration observed against the acceleration Newtonian gravity predicts from the stars and gas detected. The Atlas describes the comparison and takes no side on the cause.`} p={`${total.toLocaleString('en')} measurements, from small star clusters to giant clusters of galaxies. On the dashed line, the pull matches what Newton’s gravity predicts from the stars and gas we can see. Above it, the pull is stronger. The Atlas describes this; it doesn’t take sides on why.`} /></p>
    </section>

    <section class="hero">
      <div class="hero-main">
        <figure class="chart">
          <a class="chart-link" href={`${base}map/`} aria-describedby="front-fig-title">
          <span class="sr-only"><L t="Open the interactive map" p="Open the full map" /></span>
          <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="front-fig-title">
            <title id="front-fig-title">{`Scatter plot of observed against Newtonian baryonic acceleration, log axes, ${total.toLocaleString('en')} measurements from ${nWords} datasets at the sources’ default assumptions. A dashed line marks equality. At high accelerations points lie near it; at lower accelerations most lie above it.`}</title>
            <rect x={ML} y={MT} width={pw} height={ph} style="fill:var(--panel)" />
            <Fragment set:html={svg} />
            <text x={f1(lx)} y={f1(ly)} class="lbl" transform={`rotate(-${ang.toFixed(1)} ${f1(lx)} ${f1(ly)})`}><tspan data-l="t">g_obs = g_bar</tspan><tspan data-l="p">no extra pull</tspan></text>
            <text x={f1(ML + pw / 2)} y={H - 8} text-anchor="middle" class="axis short"><tspan data-l="t">log g_bar (m s⁻²)</tspan><tspan data-l="p">Pull from visible matter</tspan></text>
            <text x={f1(ML + pw / 2)} y={H - 8} text-anchor="middle" class="axis long"><tspan data-l="t">log g_bar, Newtonian acceleration from detected baryons (m s⁻²)</tspan><tspan data-l="p">Pull from the visible matter (log scale)</tspan></text>
            <text x="22" y={f1(MT + ph / 2)} text-anchor="middle" class="axis short" transform={`rotate(-90 22 ${f1(MT + ph / 2)})`}><tspan data-l="t">log g_obs (m s⁻²)</tspan><tspan data-l="p">Observed pull</tspan></text>
            <text x="22" y={f1(MT + ph / 2)} text-anchor="middle" class="axis long" transform={`rotate(-90 22 ${f1(MT + ph / 2)})`}><tspan data-l="t">log g_obs, observed acceleration (m s⁻²)</tspan><tspan data-l="p">Observed pull (log scale)</tspan></text>
          </svg>
          <span class="chart-cue" aria-hidden="true"><L t="Open the interactive map →" p="Explore the full map →" /></span>
          </a>
          <figcaption class="small"><L t="At the sources’ default assumptions. Each mark is one packaged measurement; ring-and-dot marks are strong lenses, projected values (D-064); diamonds are stacked weak-lensing bins. No fitted relation is drawn (D-026)." p="Using each study’s own standard assumptions. Each mark is one measurement. Rings with a dot are galaxies that bend light; diamonds are averages over many galaxies." /></figcaption>
        </figure>
        <ul class="legend-front" aria-label="Datasets">
          {dsInfo.map((d) => <li><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><Fragment set:html={legendShape(d.shape, d.v)} /></svg><L t={d.t} p={d.p} /></li>)}
        </ul>
      </div>
      <aside class="hero-side">
        <div class="card read">
          <h2><L t="Reading the chart" p="How to read it" /></h2>
          <ul>
            <li><L t="Each point is one published measurement, traced to its source." p="Each dot is one real measurement from a published study." /></li>
            <li><L t="On the dashed line, the observed acceleration equals the Newtonian prediction from detected baryons." p="On the line, the pull is what the visible matter gives." /></li>
            <li><L t="Above it, more acceleration is observed than the detected baryons predict." p="Above the line, the pull is stronger than that." /></li>
            <li><L t="Motions and light-bending are separate channels, drawn with different marks and never merged." p="Motions and light-bending are measured differently, so they get different marks." /></li>
          </ul>
        </div>
        <a class="btn primary big" href={`${base}map/`}><L t="Open the full map →" p="Explore the full map →" /></a>
        <a class="btn big" href={`${base}data/`}><L t="Download the data" p="Get the data" /></a>
      </aside>
    </section>

    <section class="status card" aria-labelledby="status-h">
      <h2 id="status-h" class="kicker"><L t="Release status" p="How far along this is" /></h2>
      <p><L t="v0.2 is preliminary and not peer reviewed. An audit of 254 randomly sampled rows, read by AI agents, found no wrong values, but did not pass on source records and methods text. Fixes are under way for v0.3." p="This is an early version and hasn’t been checked by outside experts. Our own check of 254 random rows, done with AI readers, found no wrong numbers, but some source records and method notes are incomplete. We’re fixing that now." /></p>
      <a href={`${base}reproduction/#audit`}><L t="Read the audit result →" p="See our check →" /></a>
    </section>

    <section class="routes">
      <div class="card">
        <h3><L t="Explore" p="Explore" /></h3>
        <p><L t="The full map with every view and control, one page per system, and the scale strip." p="The full map, a page for every galaxy and cluster, and how the pull changes with size." /></p>
        <p class="links"><a href={`${base}map/`}><L t="Full map →" p="Full map →" /></a><a href={`${base}systems/`}><L t="Systems →" p="Galaxies and clusters →" /></a><a href={`${base}strip/`}><L t="Scale strip →" p="Size strip →" /></a></p>
      </div>
      <div class="card">
        <h3><L t="Use the data" p="Use the data" /></h3>
        <p><L t="Every dataset as a versioned package with its conversion code and frozen tests. Cite the release by its DOI." p="Download every dataset, with the code that built it." /></p>
        <p class="links"><a href={`${base}data/`}><L t="Downloads →" p="Downloads →" /></a><a href={`${base}about/#cite`}><L t="How to cite →" p="How to cite →" /></a><a href={`https://doi.org/${CONCEPT_DOI}`}>DOI {CONCEPT_DOI} →</a></p>
      </div>
      <div class="card">
        <h3><L t="Check our work" p="Check our work" /></h3>
        <p><L t="How each value is derived, the reproduction checks, the known issues and every decision with its reason." p="How each number is worked out, our checks, and the problems we know about." /></p>
        <p class="links"><a href={`${base}methods/`}><L t="Methods →" p="How it works →" /></a><a href={`${base}reproduction/`}><L t="Checks →" p="Checks →" /></a><a href={`${base}known-issues/`}><L t="Known issues →" p="Known issues →" /></a><a href={`${REPO}/blob/main/docs/decisions.md`}><L t="Decision log →" p="Our decisions →" /></a></p>
      </div>
    </section>

    <section class="sources" aria-labelledby="sources-h">
      <h2 id="sources-h"><L t={`${nWords[0].toUpperCase() + nWords.slice(1)} published datasets`} p="Where the measurements come from" /></h2>
      <ul>
        {dsInfo.map((d) => <li><span class="dot" style={`background:var(--${d.v})`}></span><span><a href={d.href}><L t={d.name_t} p={d.name_p} /></a><br /><span class="small"><L t={`${d.size} · ${d.method_t}`} p={`${d.size} · ${d.method_p}`} /></span></span></li>)}
      </ul>
    </section>
  </div>
</Base>

<style>
  .front { max-width: 1280px; margin: 0 auto; padding: 36px 0 24px; display: flex; flex-direction: column; gap: 40px; }
  .intro { display: flex; flex-direction: column; gap: 12px; max-width: 920px; }
  .headline { margin: 0; font-family: 'Inter Tight', var(--sans); font-weight: 700; font-size: clamp(30px, 4.2vw, 46px); line-height: 1.08; letter-spacing: -0.025em; }
  .lede { margin: 0; font-size: clamp(16px, 1.5vw, 19px); line-height: 1.55; color: var(--muted); max-width: 72ch; }
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 36px; align-items: start; }
  .hero-main { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .chart { margin: 0; background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: 18px; }
  .chart svg { display: block; width: 100%; height: auto; }
  /* The preview chart opens the interactive map (the same data, explorable). */
  .chart-link { position: relative; display: block; border-radius: 10px; color: inherit; text-decoration: none; cursor: pointer; }
  .chart-link:focus-visible { outline: 2px solid var(--accent, var(--sel)); outline-offset: 4px; }
  .chart-cue { position: absolute; right: 10px; bottom: 34px; padding: 6px 10px; border-radius: 999px; font-size: 13px;
    background: var(--bg); border: 1px solid var(--line); color: var(--ink); opacity: 0; transform: translateY(4px);
    transition: opacity .15s ease, transform .15s ease; pointer-events: none; }
  .chart-link:hover .chart-cue, .chart-link:focus-visible .chart-cue { opacity: 1; transform: none; }
  @media (hover: none) { .chart-cue { position: static; display: inline-block; margin-top: 8px; opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .chart-cue { transition: none; } }
  .chart :global(.tick) { font-family: var(--mono); font-size: 12px; fill: var(--muted); }
  .chart .axis { font-family: var(--sans); font-size: 13px; fill: var(--ink); }
  .chart .lbl { font-family: var(--sans); font-size: 13px; fill: var(--muted); }
  .chart figcaption { margin-top: 8px; }
  .chart .short { display: none; }
  .legend-front { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 14px; color: var(--muted); }
  .legend-front li { display: inline-flex; align-items: center; gap: 6px; }
  .hero-side { display: flex; flex-direction: column; gap: 12px; }
  .read h2 { margin: 0 0 8px; font-family: 'Inter Tight', var(--sans); font-size: 16px; font-weight: 700; }
  .read ul { margin: 0; padding-left: 18px; color: var(--muted); font-size: 15px; line-height: 1.5; }
  .read li { margin-bottom: 10px; }
  .btn.big { min-height: 48px; font-size: 15px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; border-radius: 10px; }
  .status { flex-direction: row; align-items: center; gap: 24px; padding: 20px 24px; }
  .status h2 { margin: 0; flex: none; font-size: 12px; }
  .status p { margin: 0; flex: 1; line-height: 1.5; }
  .status a { flex: none; font-weight: 600; }
  .routes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .routes .card { padding: 22px; gap: 8px; }
  .routes h3 { margin: 0; font-family: 'Inter Tight', var(--sans); font-size: 19px; letter-spacing: -0.01em; }
  .routes p { margin: 0; color: var(--muted); line-height: 1.5; }
  .routes .links { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: 4px; }
  .routes .links a { font-weight: 600; text-decoration: none; }
  .sources h2 { margin: 0 0 8px; font-family: 'Inter Tight', var(--sans); font-size: 22px; letter-spacing: -0.015em; }
  .sources ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 32px; }
  .sources li { display: flex; gap: 12px; align-items: flex-start; padding: 14px 0; border-top: 1px solid var(--line); line-height: 1.45; }
  .sources .dot { width: 10px; height: 10px; border-radius: 50%; margin-top: 7px; flex: none; }
  .sources a { font-weight: 600; text-decoration: none; color: var(--ink); }
  @media (max-width: 900px) {
    .front { padding-top: 20px; gap: 28px; }
    .hero { grid-template-columns: minmax(0, 1fr); }
    .chart { padding: 10px; }
    .chart :global(.tick) { font-size: 28px; }
    .chart .axis, .chart .lbl { font-size: 28px; }
    .chart .long { display: none; }
    .chart .short { display: inline; }
    .status { flex-direction: column; align-items: flex-start; gap: 10px; padding: 18px; }
    .routes, .sources ul { grid-template-columns: minmax(0, 1fr); }
  }
</style>
