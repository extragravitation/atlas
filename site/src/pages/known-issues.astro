---
import Base from '../layouts/Base.astro';
import L from '../components/L.astro';
import { loadIssues } from '../lib/issues.mjs';
import { loadAtlas } from '../lib/atlas.mjs';
import Layer from '../components/Layer.astro';
import { issuePlain } from '../lib/issues_plain.mjs';
import { datasetLabel } from '../lib/labels.mjs';
const { items, source, error, at } = await loadIssues();
const base = import.meta.env.BASE_URL;
const atlas = loadAtlas();
const sysOf = {};
for (const d of atlas.all) d.measurements.rows.forEach((r) => { sysOf[r.measurement_id] = r.system_id; });
const nameOf = Object.fromEntries(atlas.systems.map((s) => [s.id, s.name]));
const open = items.filter((i) => i.state === 'open'), closed = items.filter((i) => i.state !== 'open');
---
<Base title="Known issues" active="issues">
  <div class="doc">
    <main>
      <p class="kicker">Known issues · {open.length} open · {closed.length} resolved</p>
      <h1><L t="Known issues with the data" p="What we know is wrong or uncertain" /></h1>
      <p class="lede"><L t="Problems with packaged measurements, shown openly (D-020). Every affected measurement carries a flag and is ringed on the figures; nothing is hidden or removed. Resolved issues move to the corrections log with the release that fixed them." p="When we find a problem with the numbers, it is listed here and the affected points are marked with a ring on every chart. We do not hide them." /></p>
      <p class="small"><L t={source === 'github' ? `Read from GitHub Issues labelled known-issue at build time (${at}).` : `GitHub could not be reached at build time (${error || 'offline build'}); listed from the package files instead.`} p={source === 'github' ? `Listed from the project’s public issue tracker when the site was built (${at}).` : 'The public issue tracker could not be reached when the site was built, so this list comes from the data packages.'} /> <a href="https://github.com/extragravitation/atlas/issues?q=label%3Aknown-issue">Live list on GitHub</a> · <a href={`${base}reproduction/`}>Reproduction checks</a></p>
      {items.length === 0 && <p>No known issues.</p>}
      {items.map((i) => {
        const systems = [...new Set(i.packages.flatMap((p) => p.measurements.map((m) => sysOf[m]).filter(Boolean)))];
        const nMeas = i.packages.reduce((s, p) => s + p.measurements.length, 0);
        return <section class="card" id={`issue-${i.number}`} style="margin-top:18px">
          <p class="cap"><span data-l="t">#{i.number} · <Fragment set:html={i.statusHtml} />{i.found && <> · found <Fragment set:html={i.foundHtml} /></>}{i.closed && ` · resolved ${i.closed}`}</span><span data-l="p">#{i.number} · {i.state === 'open' ? 'still open' : `resolved${i.closed ? ' ' + i.closed : ''}`}</span></p>
          <h2 style="font-size:20px"><a href={i.url} style="color:var(--ink)">{i.title}</a></h2>
          <Layer><Fragment slot="t">{i.whatHtml ? <div class="prose small" set:html={i.whatHtml} /> : <p class="small">The description is on GitHub (linked below).</p>}</Fragment><Fragment slot="p"><p>{issuePlain(i.number)}</p></Fragment></Layer>
          {i.packages.map((p) => <p class="small" style="margin-top:6px"><span data-l="t">Dataset <a href={`${base}datasets/${p.name}/${p.version}/`}>{p.dataset}</a>{p.flag && <> · flag <code>{p.flag}</code></>} · {p.measurements.length} measurements</span><span data-l="p"><a href={`${base}datasets/${p.name}/${p.version}/`}>{datasetLabel(p.name).p} ({p.version})</a> · {p.measurements.length} {p.measurements.length === 1 ? 'measurement' : 'measurements'} affected{p.flag && ', each marked with a note'}</span></p>)}
          {systems.length > 0 && <p class="small"><L t="Systems:" p="Galaxies or clusters:" /> {systems.map((s, k) => <>{k > 0 && ', '}<a href={`${base}systems/${s}/`}>{nameOf[s]}</a></>)}</p>}
          {nMeas > 0 && <details><summary class="small">Measurement IDs ({nMeas})</summary><p class="small" style="font-family:var(--mono);word-break:break-all">{i.packages.flatMap((p) => p.measurements).join(', ')}</p></details>}
          <p class="small" style="margin-top:6px"><a href={i.url}><L t="Evidence and discussion on GitHub" p="The full record on GitHub" /></a></p>
        </section>;
      })}
    </main>
    <aside class="toc"><p class="cap">Issues</p>{items.map((i) => <a href={`#issue-${i.number}`}>#{i.number}</a>)}<p class="cap" style="margin-top:14px">Report one</p><a href="https://github.com/extragravitation/atlas/issues/new">Open an issue</a></aside>
  </div>
</Base>
