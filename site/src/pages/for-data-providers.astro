---
import Base from '../layouts/Base.astro';
import L from '../components/L.astro';
import Layer from '../components/Layer.astro';
import { REPO } from '../lib/md.mjs';
import { loadAtlas } from '../lib/atlas.mjs';
import { datasetCount, datasetNames } from '../lib/labels.mjs';
const atlas = loadAtlas();
const nDs = datasetCount(atlas.datasets);
const base = import.meta.env.BASE_URL;
---
<Base title="For data providers" active="">
  <div class="doc">
    <main class="prose">
      <p class="kicker"><L t="For data providers" p="For data providers" /></p>
      <h1><L t="How the Atlas would use your data" p="How we would use your data" /></h1>
      <Layer as="p" class="lede"><Fragment slot="t">The Atlas of Extra Gravitation compiles published measurements in which the observed acceleration can be compared with Newtonian gravity on detected baryons, across every kind of system from the Solar System to colliding clusters. It takes no side on the cause of any discrepancy. This page explains what we do with a dataset and what we ask for.</Fragment><Fragment slot="p">This Atlas collects published measurements of how strongly things are pulled, and compares them with what the detected matter should do. It takes no side on why they differ. Here is what we would do with your data.</Fragment></Layer>
      <p class="boxed"><L t={`This is a pre-release preview: ${nDs} are in (${datasetNames(atlas.datasets)}). Explore them on the map and the system pages to see how a dataset is presented.`} p={`This is an early preview with ${nDs}. Have a look around the map and the pages for single galaxies and clusters.`} /> <a href={`${base}`}>Map</a> · <a href={`${base}coverage/`}>Coverage</a> · <a href={`${base}datasets/`}>Datasets</a></p>

      <h2><L t="What we do with a dataset" p="What we do" /></h2>
      <ol>
        <li><L t="Read your paper and data documentation at source, and record what was read, when, and the file hashes." p="Read your paper and files carefully and record exactly what we used." /></li>
        <li><L t="Before converting anything, write and freeze a reproduction test: the numbers in your publication that our conversion must reproduce, with tolerances." p="Before converting, lock in a test: our version must match numbers you published." /></li>
        <li><L t="Convert to the Atlas data standard, keeping your observables as released (velocities, dispersions, temperatures and densities, lensing signals, starlight and gas) alongside g_obs and g_bar, with every assumption named and your defaults and published ranges for the adjustable ones." p="Convert the data, keeping what you measured, and write down every assumption." /></li>
        <li><L t="Publish the result of the test whether it passes or fails. Any measurement that does not reproduce is flagged, listed publicly, and referred to you before anything is concluded." p="Publish the test result either way. If something does not match, we ask you about it first." /></li>
        <li><L t="Credit you on every page that uses the data: the citation you ask for, on the dataset page, each system page and every download." p="Credit you everywhere the data appear." /></li>
      </ol>

      <h2><L t="What we ask for" p="What we ask" /></h2>
      <ul>
        <li><L t="Machine-readable tables of the observables and of the baryonic components (or the quantities they are computed from), with uncertainties and units." p="Your measurements in tables a computer can read, with their uncertainties." /></li>
        <li><L t="The terms under which the tables may be redistributed. Where redistribution is not allowed, the Atlas fetches the files from your address at build time and verifies them by hash; nothing is copied into the repository." p="Whether we may share copies. If not, we link to your files instead." /></li>
        <li><L t="The citation you want used." p="How you want to be cited." /></li>
      </ul>

      <h2><L t="How it is built" p="How it is built" /></h2>
      <p><L t="Everything is public: data, code, decisions and their reasons." p="Everything is open to inspection." /> <a href={REPO}>Repository</a> · <a href={`${REPO}/blob/main/docs/decisions.md`}>Decision log</a> · <a href={`${REPO}/blob/main/docs/data-standard.md`}>Data standard</a> · <a href={`${base}methods/`}>Methods</a></p>
      <p><L t="Questions: reply to the message that brought you here, or open an issue in the repository." p="Questions: reply to the message you received, or open an issue on GitHub." /></p>
    </main>
  </div>
</Base>
