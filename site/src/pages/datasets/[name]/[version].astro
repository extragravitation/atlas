---
// One data package: what it is, how it was converted and tested, its assumptions, its known
// issues and its files. Rendered from the package's own documents and tables.
import Base from '../../../layouts/Base.astro';
import L from '../../../components/L.astro';
import Layer from '../../../components/Layer.astro';
import { loadAtlas } from '../../../lib/atlas.mjs';
import { loadIssues } from '../../../lib/issues.mjs';
import fs from 'node:fs';
import path from 'node:path';
import { datasetLabel, assumptionLabel, fmtParam, rangeLabel, systemsText, plottedSystemCount } from '../../../lib/labels.mjs';
import { linkRefs, decisionUrl } from '../../../lib/refs.mjs';
import { ROOT } from '../../../lib/atlas.mjs';
import SourceConversion from '../../../components/SourceConversion.astro';
import { md, resultLine, REPO } from '../../../lib/md.mjs';
import LensDataset from '../../../components/LensDataset.astro';
import SparcSelection from '../../../components/SparcSelection.astro';
import UncertaintyTerms from '../../../components/UncertaintyTerms.astro';
import Quote from '../../../components/Quote.astro';
import EpochCut from '../../../components/EpochCut.astro';
import { isLensing } from '../../../lib/lensing.mjs';
import { sliderNotes } from '../../../lib/terms.mjs';

export function getStaticPaths() {
  return loadAtlas().all.map((d) => ({ params: { name: d.name, version: d.version } }));
}
const { name, version } = Astro.params;
const atlas = loadAtlas();
const d = atlas.all.find((x) => x.name === name && x.version === version);
const lab = datasetLabel(d.name);
const base = import.meta.env.BASE_URL;
const repoDir = `data/packages/${d.name}/${d.version}`;
const rr = resultLine(d.md.reproductionResult), mt = resultLine(d.md.modelTestResult);
const checks = d.checksums.trim().split('\n').filter(Boolean).map((l) => { const [h, ...f] = l.trim().split(/\s+/); return { h, f: f.join(' ').replace(/^\*/, '') }; });
const stems = d.files.map((f) => f.replace(/^tables\//, '').replace(/\.ecsv$/, ''));
const dl = (f) => `${base}downloads/${d.name}/${d.version}/${f}`;
const issues = await loadIssues();
const listed = new Set(d.knownIssues.map((k) => k.issue));
const named = issues.items.filter((i) => !listed.has(i.number) && (i.mentions || []).includes(`${d.name}/${d.version}`));
const counts = {}, altCounts = {};
// Alternative rows (appended values the source does not prefer, D-096 rule 1) are counted apart, so a
// flag count can be read against a result file that counts the primary rows.
const isAlt = (r) => !!(r.alternative_of && String(r.alternative_of).trim()) || r.role === 'alternative_value';
for (const r of d.measurements.rows) for (const f of (r.flags || '').split(';').filter(Boolean)) { counts[f] = (counts[f] || 0) + 1; if (isAlt(r)) altCounts[f] = (altCounts[f] || 0) + 1; }
const flagText = (f, n) => { const a = altCounts[f] || 0; return a ? `${f} (${n}: ${n - a} primary row${n - a === 1 ? '' : 's'} and ${a} alternative row${a === 1 ? '' : 's'})` : `${f} (${n})`; };
const anyAlt = Object.keys(altCounts).length > 0;
// Plain-language summary, from the dataset's labels and its counts.
const nRows = d.measurements.rows.length, nPlotted = d.measurements.rows.filter((r) => r.plotted !== 'false').length;
const nSys = d.systems ? d.systems.rows.length : 0, nSysPlotted = d.systems ? plottedSystemCount(d) : 0;
// Systems counted from the measurement rows themselves; systems listed without rows are said apart (X-COP v2 audit X5).
const nSysRows = d.systems ? new Set(d.measurements.rows.map((r) => r.system_id)).size : 0, nSysNoRows = nSys - nSysRows;
const summaryP = `${lab.kind_p}. How it was measured: ${lab.method_p.charAt(0).toLowerCase() + lab.method_p.slice(1)}. ${nRows.toLocaleString('en')} measurements${d.systems ? ` from ${nSysRows.toLocaleString('en')} ${nSysRows === 1 ? lab.unit : lab.units}` : ''}; ${nSysPlotted && nSysPlotted < nSysRows ? `${nSysPlotted} of these ${lab.units} are on the map, and the rest are kept in the record with the reason.` : nPlotted < nRows ? `${nPlotted.toLocaleString('en')} of the measurements are on the map, and the rest are kept in the record with the reason.` : 'all of them are on the map.'}${nSysNoRows > 0 ? ` ${nSysNoRows} more ${nSysNoRows === 1 ? lab.unit + ' is' : lab.units + ' are'} listed in the record with no measurements, and the reason.` : ''}`;
// The reproduction badge says the same in both layers; where the test has two parts, it names the part it reports.
const twoPart = !!d.md.reproductionResultA;
const badge = rr ? (rr.pass ? [`Reproduction${twoPart ? ', part B' : ''}: passed`, `Our reproduction check${twoPart ? ', part B' : ''}: passed`] : [`Reproduction${twoPart ? ', part B' : ''}: not fully reproduced, on record`, 'Does not fully match the source; shown, with the mismatches marked']) : null;
// Plain account of the reproduction check (data/reproduction.json, the Reproduction page's ledger).
const ledger = JSON.parse(fs.readFileSync(path.join(ROOT, 'data/reproduction.json'), 'utf8')).datasets.find((x) => x.package === d.key);
const reproP = ledger ? [ledger.matched_plain && `${ledger.matched_plain}.`, ledger.scope_plain, ledger.status_plain].filter(Boolean).join(' ') : 'The check of this dataset against its source is described on the Reproduction page.';
const channels = [...new Set(d.measurements.rows.map((r) => r.channel))];
const lens = isLensing(d);
const toc = [['summary', 'Summary'], ['validation', 'Validation'], ...(lens ? [['tests', 'Tests'], ['funnel', 'From read to plotted'], ['check-formula', 'Check: Einstein mass'], ['check-profile', 'Check: profile step']] : []), ...(d.name === 'aeg-d-sparc' ? [['selection', 'The authors’ selection']] : []), ...(d.name === 'aeg-d-kids1000-rar' ? [['measured', 'As measured']] : []), ...(d.terms ? [['uncertainties', 'Uncertainties']] : []), ['assumptions', 'Assumptions'], ['issues', 'Known issues and flags'], ['files', 'Files and checksums'], ['columns', 'Columns'], ['source', 'Source and conversion']];
---
<Base title={`${lab.t} ${d.version}`} description={d.title} active="datasets">
  <div class="doc">
    <main>
      <p class="kicker"><a href={`${base}datasets/`} style="color:inherit">Datasets</a> · {d.name} · {d.version}</p>
      <h1>{d.title}</h1>
      {!d.current && <p class="boxed" style="margin:8px 0"><L t={`Superseded by ${d.supersededBy}. This version stays published unchanged; the map and system pages use the latest version.`} p={`There is a newer version (${d.supersededBy.split('/')[1]}). This one is kept unchanged.`} /> <a href={`${base}datasets/${d.supersededBy}/`}>Latest version</a></p>}
      {d.current && d.versions.length > 1 && <p class="small" style="margin:8px 0"><L t="Earlier versions, still published unchanged:" p="Older versions, kept unchanged:" /> {d.versions.filter((k) => k !== d.key).map((k, i) => <>{i > 0 && ', '}<a href={`${base}datasets/${k}/`}>{k.split('/')[1]}</a></>)}</p>}
      {(d.pending || []).map((p) => <p class="boxed" style="margin:8px 0" id="pending">{p.notice}</p>)}
      {d.dp.x_publication && d.dp.x_publication !== 'published' && <p class="boxed" style="margin:8px 0"><L t="Not published: this version awaits the authors' confirmation (D-090 rule 5). This page exists only in a local build; its tables are not in the repository." p="Not public yet: we are waiting for the authors to confirm. This page is a private preview." /></p>}

      <h2 id="summary"><L t="Summary" p="In short" /></h2>
      <Layer as="div" class="para"><Fragment slot="t"><Quote text={d.dp.description} /></Fragment><Fragment slot="p">{summaryP}</Fragment></Layer>
      {/D-097/.test(d.dp.description || '') && <Layer as="p" class="small"><Fragment slot="t">The equilibrium rule above (D-097 to D-100) is so far written for velocity-dispersion data. <a href={decisionUrl('D-109')}>D-109</a> rule 3 extends one written equilibrium test, frozen before it is applied, to hydrostatic X-ray masses and rotation curves; two independent readers apply it to the X-COP sources after v0.2, then to SPARC. Until then X-COP's A2319 stays plotted, flagged with its source's statement (<a href={`${base}systems/aeg-s-000183/#flag`}>A2319</a>).</Fragment><Fragment slot="p">The rule that keeps unsettled systems off the map is so far written for this kind of measurement only. One test for every method is to be applied after version 0.2. Until then a galaxy cluster whose source says its gas is not settled (<a href={`${base}systems/aeg-s-000183/#flag`}>A2319</a>) stays on the map, with a note.</Fragment></Layer>}
      <dl class="facts">
        <div><dt><L t="Method" p="How it was measured" /></dt><dd><L t={lab.method_t} p={lab.method_p} /></dd></div>
        <div><dt>Channel</dt><dd>{channels.join(', ')}</dd></div>
        <div><dt>Measurements</dt><dd>{d.measurements.rows.length.toLocaleString('en')}</dd></div>
        {d.systems && <div><dt>Systems</dt><dd>{systemsText(d)}</dd></div>}
        <div><dt>Data standard</dt><dd>{d.dp.x_standard_version}</dd></div>
        {d.hasCovariance && <div><dt>Covariance</dt><dd>included</dd></div>}
      </dl>
      {d.name === 'aeg-d-xcop' && d.version === 'v2' && <>
        <Layer as="p"><Fragment slot="t">{'X-COP v2 takes g_obs and g_bar as released by Eckert et al. 2022, so its values differ from v1\'s by ruling (D-090).'}</Fragment><Fragment slot="p">{'Version 2 uses the values the authors released in 2022, so its numbers differ from version 1.'}</Fragment></Layer>
        <Layer as="p"><Fragment slot="t">{'The source states that its hydrostatic masses are "mildly biased (<10%) out to R500" and that "The HSE assumption is likely to be a poorer approximation beyond this point" (Eckert et al. 2022, l. 502). At R200 it gives "a mild contribution of nonthermal pressure (10-20%)" (l. 539).'}</Fragment><Fragment slot="p">{'The source says its masses are “mildly biased”, by less than 10 %, out to a standard cluster radius, R500, and that its assumption that the gas is in balance is likely to hold less well beyond that. Farther out, at R200, it says pressure that does not come from the heat of the gas makes a mild contribution, 10–20 %.'}</Fragment></Layer>
      </>}
      <h3><L t="Cite" p="How to give credit" /></h3>
      <Layer as="p" class="small"><Fragment slot="t">Cite the original sources and this package version as follows.</Fragment><Fragment slot="p">Please name the original study, and this version of the data, when you use these numbers. The exact wording to use is:</Fragment></Layer>
      <p class="boxed">{d.citation}</p>
      <h3><L t="Licence" p="Reuse" /></h3>
      <Layer as="p"><Fragment slot="t">{d.licence}</Fragment><Fragment slot="p">Our own tables may be reused with credit, unless the original study’s terms say otherwise. Where a study does not allow copies, we link to its files instead of copying them. The technical view gives the terms for each source.</Fragment></Layer>

      <h2 id="validation">Validation</h2>
      {d.dp.x_publication && d.dp.x_publication !== 'published' ? <p class="small"><a href={`${REPO}/blob/main/${repoDir}/REPRODUCTION_RESULT_PART_B.md`}><L t="Part B result (outcomes and counts only)" p="How this version was checked" /></a> · <a href={`${REPO}/blob/main/${repoDir}/REPRODUCTION_RESULT_PART_A.md`}><L t="Part A result" p="Earlier checks" /></a></p> : <p class="small"><a href={`${base}reproduction/#${d.key.replace('/', '-')}`}><L t="This dataset on the Reproduction page" p="How this dataset was checked" /></a> · <a href={`${base}reproduction/`}><L t="All datasets' checks" p="All checks" /></a>{d.md.reproductionResultA && <> · <a href={`${REPO}/blob/main/${repoDir}/REPRODUCTION_RESULT_PART_A.md`}><L t="Part A result" p="Earlier checks" /></a> · <a href={`${REPO}/blob/main/${repoDir}/REPRODUCTION_RESULT_PART_B.md`}><L t="Part B result" p="How this version was checked" /></a></>}</p>}
      {rr && <p><span class={'badge ' + (rr.pass ? 'ok' : 'fail')}><L t={badge[0]} p={badge[1]} /></span>{twoPart && <span class="small"> <L t="Part A's result stands beside it, unchanged; see below." p="Our earlier checks of the source files are described below." /></span>}</p>}
      {rr && !rr.pass && <p class="small">{counts.reproduction_mismatch || 0} measurements that do not reproduce are flagged <code>reproduction_mismatch</code> and ringed on every figure; the package ships under decision D-019 because conversion integrity passes.</p>}
      {mt && <p><span class={'badge ' + (mt.pass ? 'ok' : 'fail')}>Modelled-star test: {mt.text}</span></p>}
      <p class="small"><L t="Each test was written and frozen by hash before it was run; the result is published whether it passed or failed." p="We wrote each test down and locked it before looking at the result, and we show the result either way." /> <a href={`${REPO}/blob/main/${repoDir}/REPRODUCTION.md`}>Frozen test</a>{d.md.modelTest && <> · <a href={`${REPO}/blob/main/${repoDir}/MODEL_TEST.md`}>Frozen modelled-star test</a></>}</p>
      <Layer as="p" class="small"><Fragment slot="t">{ledger && ledger.status}</Fragment><Fragment slot="p">{reproP}</Fragment></Layer>
      {d.md.reproductionResult && <details><summary><L t="Reproduction result in full" p="The full technical report of the check" /></summary><div class="prose" set:html={md(d.md.reproductionResult, repoDir)} /></details>}
      {lens && <LensDataset d={d} />}
      {d.name === 'aeg-d-sparc' && <SparcSelection d={d} />}
      {d.md.modelTestResult && <details><summary>Modelled-star test result in full</summary><div class="prose" set:html={md(d.md.modelTestResult, repoDir)} /></details>}

      {d.name === 'aeg-d-kids1000-rar' && <>
        <h2 id="measured"><L t="As measured" p="What was actually measured" /></h2>
        <p><L t="The source's own quantities per bin, before the Atlas converts them (D-029): the tangential excess surface density ΔΣ_t with its error, the cross component ΔΣ_× (a null check), and the multiplicative calibration (1+K), as released. The Atlas computes g_obs = 4 G ΔΣ_t / (1+K), the authors' singular-isothermal-sphere conversion. Bins are in g_bar, as released; ΔΣ is in h70 M☉ pc⁻²." p="Before conversion, the source gives the light-bending signal around the galaxies in each group, which the Atlas turns into a pull." /></p>
        <div class="tablebox" tabindex="0"><table><thead><tr><th class="l">Sample</th><th>g_bar (m s⁻²)</th><th>ΔΣ_t</th><th>error</th><th>ΔΣ_×</th><th>1+K</th><th>g_obs (m s⁻²)</th></tr></thead><tbody>
          {d.measurements.rows.map((r) => <tr><td class="l">{(r.x_kids1000_rar_sample || '').replace(/_/g, ' ')}</td><td>{r.g_bar.toExponential(3)}</td><td>{r.x_kids1000_rar_esd_t}</td><td>{r.x_kids1000_rar_esd_err}</td><td>{r.x_kids1000_rar_esd_x}</td><td>{r.x_kids1000_rar_bias}</td><td>{r.g_obs.toExponential(3)}</td></tr>)}
        </tbody></table></div>
        {d.measurements.rows.some((r) => r.plotted !== undefined) && <>
          <h3 id="plotted"><L t="What is plotted" p="Which bins are drawn" /></h3>
          <Layer as="p" class="small"><Fragment slot="t">All 45 bins are in the tables and downloads, with no value changed from v1. Two kinds of bin are recorded but not plotted, following the source's own choices (D-096). <b>KiDS-bright bins 1–8</b> (g_bar below 7.56×10⁻¹⁴ m s⁻²) lie beyond the source's isolation limit. The authors leave them out of their tests of analytical models: photometric-redshift errors let non-isolated lenses into the sample, which raises ΔΣ by about 30 % at large radii (Brouwer et al. 2021, l. 508, 748, 821; D-103). They are kept here, unplotted, with the quotations in their notes. <b>The hot-gas variant</b> adds an assumed hot-gas component, which the source calls "only a rough order of magnitude estimate"; its "fiducial estimate" is stars plus cold gas (D-096 rule 3). GAMA bins are plotted at every g_bar: the source calls GAMA "still reliable" there.</Fragment><Fragment slot="p">Every bin is kept in the downloads. Two kinds are not drawn on the map. The eight faintest KiDS-bright bins are left out because the survey team themselves leave them out: their way of picking lone galaxies lets in neighbours at those distances, which inflates the signal. The version with extra assumed gas is left out because the team call it only a rough estimate. The GAMA bins, which the team consider reliable, are drawn everywhere.</Fragment></Layer>
          {d.version === 'v2' && <p class="small"><a href={`${REPO}/blob/main/${repoDir}/REPRODUCTION_REV3.md`}>Frozen test for this version (re-issued under D-103)</a></p>}
        </>}
      </>}

      {d.terms && <><h2 id="uncertainties"><L t="Uncertainties by scale" p="How sure are these numbers?" /></h2><UncertaintyTerms d={d} /></>}
      <h2 id="assumptions">Assumptions</h2>
      <p class="small"><L t="From the assumption registry (data/assumptions.json). Effects are the formulas the site and the pipeline both execute; nothing is approximated." p="Every assumption behind these numbers, with the published values it can take." /></p>
      <div tabindex="0" class="tablebox" style="max-height:none">
        <table>
          <thead><tr><th class="l">Assumption</th><th class="l">Status</th><th class="l">Scope</th><th>Default</th><th>Range</th><th class="l">Sources</th></tr></thead>
          <tbody>
            {d.assumptions.map((a) => { const e = a.datasets[d.key], k = assumptionLabel(a.id).kind; return <tr>
              <td class="l" style="white-space:normal;min-width:180px"><L t={a.name_technical} p={a.name_plain || a.name_technical} /><br><code class="small">{a.id}</code></td>
              <td class="l">{a.adjustable ? (a.status === 'confirmed' ? 'adjustable' : a.status) : 'fixed'}</td>
              <td class="l">{a.scope === 'system' ? 'per system' : a.scope === 'dataset' ? 'whole dataset' : '–'}</td>
              <td>{typeof e.default === 'number' ? fmtParam(k, e.default) : e.default}</td>
              <td>{rangeLabel(a.id, e)}</td>
              <td class="l" style="white-space:normal;min-width:260px;font-size:12px">{e.default_ref && <>Default: <Quote text={e.default_ref} pkgDir={repoDir} /><br></>}{e.range_ref && <>Range: <Quote text={e.range_ref} pkgDir={repoDir} /></>}{e.note && <><br><Quote text={e.note} pkgDir={repoDir} /></>}</td>
            </tr>; })}
          </tbody>
        </table>
      </div>
      {d.assumptions.filter((a) => a.adjustable && a.status === 'confirmed').map((a) => { const n = sliderNotes(d, a); return [n.range, n.fixed].filter(Boolean).map((x) => <p class="small" style="margin-top:6px"><b><L t={`${a.id}:`} p={`${assumptionLabel(a.id).p}:`} /></b> <L t={x[0]} p={x[1]} /></p>); })}
      <details style="margin-top:10px"><summary>Effect formulas</summary>
        {d.assumptions.filter((a) => (a.datasets[d.key].effects || []).length).map((a) => <div style="margin-top:8px"><p class="small"><b>{a.id}</b> (p = parameter, p0 = default)</p><pre class="code formula">{a.datasets[d.key].effects.map((e) => `${e.column} ← ${e.formula}`).join('\n')}</pre></div>)}
      </details>

      <h2 id="issues">Known issues and flags</h2>
      {d.knownIssues.length === 0 && named.length === 0 && <p>No known issues.</p>}
      {named.length > 0 && <ul>{named.map((i) => <li><a href={i.url}>#{i.number}</a>: {i.title} <span class="small">({i.state === 'closed' ? `resolved ${i.closed || ''}` : 'open'}; recorded on GitHub, not in the package file)</span></li>)}</ul>}
      {d.knownIssues.length > 0 && <ul>{d.knownIssues.map((k) => <li><a href={k.url}>#{k.issue}</a>: {k.title} ({(k.measurements || []).length} measurements{k.flag && <>, flag <code>{k.flag}</code></>})</li>)}</ul>}
      {Object.keys(counts).length > 0 && <Layer as="p" class="small"><Fragment slot="t">Flags in this package, counted from its measurements table: {Object.entries(counts).map(([f, n]) => flagText(f, n)).join(', ')}.{anyAlt && ' Alternative rows are appended values that the source does not prefer (D-096 rule 1); a result file that counts the primary rows gives the smaller number.'}</Fragment><Fragment slot="p">{Object.keys(counts).length === 1 ? 'One kind of note is attached to rows of this table.' : `${Object.keys(counts).length} kinds of note are attached to rows of this table.`}{anyAlt && ' Some of those rows are second versions of a value that the source does not prefer, and the counts include them.'} The technical view names each note and gives its count.</Fragment></Layer>}
      {d.name === 'aeg-d-xcop' && d.version === 'v1' && <Layer as="p" class="small"><Fragment slot="t"><b>Correction (2026-11-02).</b> For the seven clusters with measured stars, this version treats the released stellar-mass profiles as masses enclosed in a sphere. The source paper says they are projected (Ghizzardi et al. 2021, §5.1). A projected mass is never smaller than the spherical one, so the stellar part of g_bar here is an upper bound, and g_bar is too high wherever stars contribute: by a factor of 1/0.75 in the stellar term at R500, the source's own conversion, and by an amount the source does not determine in the cluster centres, where stars dominate. This is the Atlas's error. This version stays published unchanged; the next version will mark these values as upper bounds (D-088, <a href="https://github.com/extragravitation/atlas/issues/124">#124</a>).</Fragment><Fragment slot="p"><b>Correction (2 November 2026).</b> We made a mistake. For seven clusters, the star masses in the released files are measured through a column of sky, not inside a ball, and we treated them as if they were inside a ball. That makes the pull from detected matter look too large, most of all near the cluster centres. This version stays as it was, so the record is clear; the next version will show these values as upper limits (<a href="https://github.com/extragravitation/atlas/issues/124">#124</a>).</Fragment></Layer>}
      {d.name === 'aeg-d-kids1000-rar' && <Layer as="p" class="small"><Fragment slot="t"><b>Error bars.</b> The g_obs errors are the released ESD errors, bias-corrected, as the release README's recipe gives them. The paper also adds 0.1 dex to every RAR error bar for the conversion from ΔΣ to g_obs (Brouwer et al. 2021, §4.4). The release does not include that term, so this version's error bars are smaller than the paper's. The paper does not say how the two were combined; the question is with the authors, and the next version will show the conversion term separately. The <code>no_uncertainty</code> flag on every row refers to <b>g_bar</b> only: the release gives no per-bin g_bar uncertainty. The paper's ±0.2 dex systematic in stellar mass (Fig. 4) is stated in words, not drawn (<a href="https://github.com/extragravitation/atlas/issues/64">#64</a>).</Fragment><Fragment slot="p"><b>Error bars.</b> The error bars here come from the released data. The paper adds a further allowance for the step that turns the lensing signal into a pull, which the released data leave out, so these bars are smaller than in the paper. We have asked the authors how to add it, and the next version will show it. The detected-matter side has no error bar in the released data; the paper's uncertainty in the star masses is described in words (<a href="https://github.com/extragravitation/atlas/issues/64">#64</a>).</Fragment></Layer>}
      <p class="small"><a href={`${base}known-issues/`}>All known issues</a></p>

      <h2 id="files">Files and checksums</h2>
      <ul>
        {stems.map((s) => <li><b>{s}</b>: <a href={dl(s + '.ecsv')}>ECSV</a> (exact package file) · <a href={dl(s + '.csv')}>CSV</a> (same values, header removed)</li>)}
        <li><a href={dl('datapackage.json')}>datapackage.json</a> · <a href={dl('sources.json')}>sources.json</a> · <a href={dl('checksums.sha256')}>checksums.sha256</a></li>
        <li><a href={`${REPO}/tree/main/${repoDir}`}>The full package in the repository</a> (conversion script, tests, documents)</li>
      </ul>
      <div tabindex="0" class="tablebox" style="max-height:none"><table><thead><tr><th class="l">SHA-256</th><th class="l">File</th></tr></thead><tbody>{checks.map((c) => <tr><td class="l"><code style="font-size:11px">{c.h}</code></td><td class="l">{c.f}</td></tr>)}</tbody></table></div>

      <h2 id="columns">Columns</h2>
      <div tabindex="0" class="tablebox"><table><thead><tr><th class="l">Column</th><th class="l">Type</th><th class="l">Unit</th><th class="l">Description</th></tr></thead><tbody>
        {d.measurements.columns.map((c) => <tr><td class="l"><code>{c.name}</code></td><td class="l">{c.datatype}</td><td class="l">{c.unit || ''}</td><td class="l" style="white-space:normal;min-width:300px"><Quote text={c.description} /></td></tr>)}
      </tbody></table></div>

      <h2 id="source"><L t="Source and conversion" p="Where the data come from and how they were converted" /></h2>
      <SourceConversion d={d} repoDir={repoDir} />
    </main>
    <aside class="toc"><p class="cap">On this page</p>{toc.map(([id, t]) => <a href={'#' + id}>{t}</a>)}</aside>
  </div>
</Base>
