---
// Kinds of system and coverage (D-028): what the Atlas covers, what it will cover, and the gaps.
// Rendered from docs/plans/TAXONOMY_v2.md (D-108; version 1 is docs/plans/TAXONOMY.md, D-028), the ruled document, so the page cannot drift from it.
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import L from '../components/L.astro';
import Layer from '../components/Layer.astro';
import EpochCut from '../components/EpochCut.astro';
import { ROOT, loadAtlas } from '../lib/atlas.mjs';
import { datasetLabel, datasetCount, datasetNames, plottedSystemCount, joinAnd } from '../lib/labels.mjs';
import { md, REPO } from '../lib/md.mjs';
import { surveyName } from '../lib/lensing.mjs';
import { decisionUrl, fileUrl } from '../lib/refs.mjs';

const text = fs.readFileSync(path.join(ROOT, 'docs/plans/TAXONOMY_v2.md'), 'utf8');
const sec = (n) => { const m = text.match(new RegExp('\\n## ' + n + '\\.[^\\n]*\\n([\\s\\S]*?)(?=\\n## \\d|$)')); return m ? m[1] : ''; };
const kinds = sec(3), matrix = sec(5), protocol = sec(6), gate = sec(7);
const base = import.meta.env.BASE_URL;
// Freeze record of the selection protocol (D-028, D-035): date, commit and Zenodo deposit, from data/taxonomy.json.
const frozen = JSON.parse(fs.readFileSync(path.join(ROOT, 'data/taxonomy.json'), 'utf8'));
const frozenDate = frozen.frozen_at.slice(0, 10), frozenCommit = frozen.frozen_commit.slice(0, 7);
const d110 = decisionUrl('D-110'), devUrl = fileUrl('docs/plans/DEVIATIONS.md');
// Coverage of the packaged data on continuous axes (TAXONOMY §5b, D-033), computed from the packages.
const atlas = loadAtlas();
const rng = (a) => { const v = a.filter((x) => x !== null && x !== undefined && isFinite(x)); return v.length ? [Math.min(...v), Math.max(...v)] : null; };
const f = (v, d = 2) => (v < 0.01 || v >= 1e4 ? v.toExponential(1) : Number(v.toPrecision(3)).toString());
const nDs = datasetCount(atlas.datasets);
// Systems at or above the epoch cut (D-066 item 2): recorded in full, flagged epoch_gap_v1, not plotted.
const isGap = (x) => (x.properties ? JSON.parse(x.properties).flags || [] : []).includes('epoch_gap_v1');
const report = atlas.datasets.map((d) => {
  const rows = d.measurements.rows, all = d.systems ? d.systems.rows : [];
  const sys = all.filter((x) => !isGap(x)), nGap = all.length - sys.length;
  const props = sys.map((x) => (x.properties ? JSON.parse(x.properties) : {}));
  const dist = rng(sys.map((x) => x.distance_mpc)), z = rng(sys.map((x, i) => x.redshift ?? props[i].redshift));
  const gb = rng(rows.filter((r) => r.g_bar > 0).map((r) => Math.log10(r.g_bar))), rr = rng(rows.map((r) => r.r_kpc));
  return { name: datasetLabel(d.name).t, systems: d.systems ? `${sys.length} ${datasetLabel(d.name).units}${nGap ? ` (+ ${nGap} in the epoch gap)` : ''}` : `${rows.length} stacked bins`, n: rows.length,
    where: z ? `z = ${z[0]}–${z[1]} (source)` : dist ? `${f(dist[0])}–${f(dist[1])} Mpc (source distances)` : 'lens redshifts not recorded in the package',
    radius: rr ? `${f(rr[0])}–${f(rr[1])} kpc` : 'no single radius (binned in g_bar)', gbar: gb ? `${gb[0].toFixed(1)} to ${gb[1].toFixed(1)}` : '–' };
});
// Epoch-gap counts per dataset and survey, from the systems tables (D-066 item 2).
const gapRows = atlas.datasets.flatMap((d) => {
  if (!d.systems) return [];
  const by = new Map();
  for (const x of d.systems.rows.filter(isGap)) { const p = JSON.parse(x.properties); const k = surveyName((p.scope || '').split(' | ')[0]); if (!by.has(k)) by.set(k, []); by.get(k).push(x.redshift); }
  return [...by.entries()].sort((a, b) => b[1].length - a[1].length).map(([survey, zs]) => ({ d, survey, n: zs.length, z: Math.min(...zs) === Math.max(...zs) ? String(zs[0]) : `${Math.min(...zs)}–${Math.max(...zs)}` }));
});
const gapTotal = gapRows.reduce((n, g) => n + g.n, 0);
// What is in hand now, from the packages. The frozen matrix (§5) is rendered as written; its ● marks
// record 2026-10-28. Each package's matrix column is the tracer of g_obs (§4), a fixed property of the
// method; the kinds are counted from the plotted systems' own taxonomy_kind.
const COLUMN = { 'aeg-d-sparc': 'Rotation', 'aeg-d-gc-baumgardt': 'Random motions', 'aeg-d-dwarfs': 'Random motions', 'aeg-d-strong-lensing': 'Strong lensing', 'aeg-d-xcop': 'Hot-gas pressure', 'aeg-d-kids1000-rar': 'Weak lensing' };
const COLUMN_P = { Rotation: 'how fast discs spin', 'Random motions': 'how fast stars swarm', 'Strong lensing': 'rings and arcs of bent light', 'Hot-gas pressure': 'hot gas in balance', 'Weak lensing': 'light-bending averaged over many galaxies' };
const kindName = Object.fromEntries([...matrix.matchAll(/^\| (A\d+) ([^|]+?) \|/gm)].map((m) => [m[1], m[2].trim()]));
const inHand = atlas.datasets.map((d) => {
  const plotted = new Set(d.measurements.rows.filter((r) => r.plotted !== 'false').map((r) => r.system_id));
  const by = {};
  if (d.systems) for (const x of d.systems.rows) if (plotted.has(x.system_id) && x.taxonomy_kind) by[x.taxonomy_kind] = (by[x.taxonomy_kind] || 0) + 1;
  const kinds = Object.entries(by).sort((a, b) => b[1] - a[1]).map(([k, n]) => `${k} ${kindName[k] || ''} (${n})`.replace(/\s+\(/, ' ('));
  return { d, col: COLUMN[d.name] || d.measurements.rows[0].method_class, kinds: d.systems ? joinAnd(kinds) : 'A4 and A6, stacked (an environment selection, §3)', plotted: d.systems ? plottedSystemCount(d) : null };
});
---
<Base title="Coverage" active="coverage">
  <div class="doc">
    <main>
      <p class="kicker"><L t="Coverage · kinds of system" p="Coverage" /></p>
      <h1><L t="Every kind of system, and what the Atlas covers" p="Where we can compare the pull, and how far we have got" /></h1>
      <Layer as="p" class="lede"><Fragment slot="t">The Atlas maps every kind of system in which observed and baryonic acceleration can be compared. The first public release (v1.0) is the data in hand, after the data freeze, the re-issue under data standard 3.0.0, the formal outside review and the methods paper (<a href={d110}>D-110</a>, which narrows D-028); the remaining cells arrive in v1.x releases. This page shows the full plan and the state of each cell now: a data package, a candidate still to be searched, screened or ruled on, or a documented gap. Kinds are defined by what a system is, never by its measured discrepancy, and they organise coverage only, never the findings.</Fragment><Fragment slot="p">The Atlas aims to cover every kind of object where the pull can be compared with the matter we detect: from the Solar System and pairs of stars to colliding clusters of galaxies. The first full release (v1.0) will carry the data already in, checked and reviewed; the other kinds follow in later updates. This page shows the full plan: what is already in, what is coming, and what is missing.</Fragment></Layer>
      <p class="boxed"><L t={`Status: ${nDs} are in hand (${datasetNames(atlas.datasets)}); the table below lists them, from the packages. The coverage matrix further down is the frozen taxonomy as written: its ● marks and its counts record 2026-10-28, when three packages were in hand. Its other cells list candidates from the source survey of that date. Selection follows a protocol fixed before any new data are converted (§ Selection).`} p={`Right now ${nDs} are in; the table below shows which. The big grid further down is the plan as it was fixed on 28 October 2026, when only three were in. Everything marked ○ or ◐ there is a candidate still to be checked and chosen by fixed rules.`} /> <a href={`${base}for-data-providers/`}><L t="For data providers" p="Have data that fits?" /></a></p>
      <h2 id="in-hand"><L t="In hand now" p="What is in so far" /></h2>
      <div class="tablebox" tabindex="0" style="max-height:none"><table><thead><tr><th class="l">Dataset</th><th class="l"><L t="Matrix column (tracer of g_obs)" p="How the pull is measured" /></th><th class="l"><L t="Kinds of the plotted systems (count)" p="Kinds of object on the map" /></th></tr></thead><tbody>
        {inHand.map((x) => <tr><td class="l"><a href={`${base}datasets/${x.d.name}/${x.d.version}/`}>{datasetLabel(x.d.name).t}</a> {x.d.version}</td><td class="l"><L t={x.col} p={COLUMN_P[x.col] || x.col} /></td><td class="l">{x.kinds}</td></tr>)}
      </tbody></table></div>
      <p class="small" style="margin-top:6px"><L t="Computed from each package's systems table (taxonomy_kind of the systems with a plotted measurement). The matrix column is the tracer of g_obs (§4) for the dataset's method." p="Counted from the data, not typed in." /></p>

      <h2 id="kinds"><L t="Kinds of system" p="The kinds of object" /></h2>
      <Layer><Fragment slot="t"><div class="prose wide" set:html={md(kinds, 'docs/plans')} /></Fragment><Fragment slot="p"><p>From smallest to largest: the Solar System, pairs of stars far apart, young star clusters, old star clusters, spinning disc galaxies, small faint round galaxies, round and lens-shaped galaxies, galaxies in unusual shapes or settings, groups of galaxies, clusters of galaxies, and colliding clusters. Each kind is defined by what the object is and how it is seen, never by how much extra pull it shows, and the kinds are used to find your way around, never to sort the results. Each kind also says why it is included. Switch to the technical view for the full table.</p></Fragment></Layer>
      <h2 id="matrix"><L t="Coverage matrix (frozen, as of 2026-10-28)" p="The plan: what we have and what we need" /></h2>
      <Layer as="p"><Fragment slot="t">Rendered from the frozen taxonomy as written. The ● marks and the counts in the text below it (“three packages in hand”, “against three so far”, “one strong-lensing sample”) describe 2026-10-28; the packages in hand now are listed above.</Fragment><Fragment slot="p">Each row is a kind of object and each column a way of measuring the pull. ● means the data were in when the plan was fixed, ○ that public data were found, ◐ that a question must be settled first, and ✕ that a search found none. The marks date from 28 October 2026; what is in now is listed above. Below the grid, the plan lists the cross-checks that matter most: the same objects measured two ways, and different kinds compared at the same pull.</Fragment></Layer>
      <div class="prose wide" set:html={md(matrix, 'docs/plans')} />
      <h2 id="continuous"><L t="Coverage on continuous axes (this preview)" p="How far the current data reach" /></h2>
      <p><L t="Computed from the packaged measurements. Every dataset so far is in the nearby universe: the Atlas does not yet describe how the comparison looks at earlier cosmic times. That is a documented gap for v1.0 (D-033)." p="Everything measured so far is relatively close to us. How things looked earlier in the history of the universe is not yet covered, and we say so." /></p>
      <div class="tablebox" tabindex="0" style="max-height:none"><table><thead><tr><th class="l">Dataset</th><th class="l">Systems</th><th>Measurements</th><th class="l">Distance or redshift</th><th class="l">Radius</th><th class="l">log g_bar (m s⁻²)</th></tr></thead><tbody>
        {report.map((r) => <tr><td class="l">{r.name}</td><td class="l">{r.systems}</td><td>{r.n.toLocaleString('en')}</td><td class="l">{r.where}</td><td class="l">{r.radius}</td><td class="l">{r.gbar}</td></tr>)}
      </tbody></table></div>
      <p class="small" style="margin-top:6px"><L t="Distance or redshift: systems below the epoch cut only. Systems at z ≥ 0.30 are counted in the next section." p="Distances here are for the systems on the map." /></p>

      <h2 id="epoch-gap"><L t="The cosmic-epoch gap" p="Earlier in the history of the universe" /></h2>
      <Layer as="p"><Fragment slot="t">v1.0 plots a system with its own redshift only if that redshift, as printed by the source, is below 0.30 (D-066). Systems at or above it are recorded in full, flagged epoch_gap_v1, and counted here as part of the documented gap in cosmic epoch (D-033 item 5). They have no point on the map. Stacked samples whose bins span a range of redshift are not covered by this count (D-066 item 4).</Fragment><Fragment slot="p">This version only puts on the map objects near enough (redshift below 0.30). Farther objects, whose light set out longer ago, are kept in the record and counted here, so the gap is visible.</Fragment></Layer>
      <EpochCut />
      {gapRows.length > 0 ? (
        <div class="tablebox" tabindex="0" style="max-height:none;margin-top:8px" role="region" aria-label="Systems in the epoch gap"><table><thead><tr><th class="l">Dataset</th><th class="l"><L t="Survey" p="From" /></th><th><L t="Systems at z ≥ 0.30" p="Farther objects" /></th><th class="l"><L t="Redshift range (as printed)" p="Redshift range" /></th></tr></thead><tbody>
          {gapRows.map((g) => <tr><td class="l"><a href={`${base}datasets/${g.d.name}/${g.d.version}/#epoch-gap`}>{datasetLabel(g.d.name).t}</a></td><td class="l">{g.survey}</td><td>{g.n}</td><td class="l">{g.z}</td></tr>)}
          <tr><td class="l"><b>Total</b></td><td class="l"></td><td><b>{gapTotal}</b></td><td class="l"></td></tr>
        </tbody></table></div>
      ) : <p class="small"><L t="No system is recorded at z ≥ 0.30 yet." p="None yet." /></p>}

      <h2 id="selection"><L t={`Selection protocol (frozen ${frozenDate})`} p="How data are chosen" /></h2>
      <p class="boxed"><L t={`Status: frozen on ${frozenDate} at commit ${frozenCommit} and deposited on Zenodo (`} p={`These rules were fixed on ${frozenDate}, before any new data were chosen, and filed publicly (`} /><a href="https://doi.org/10.5281/zenodo.23780203">10.5281/zenodo.23780203</a><L t={`); data freeze ${frozen.data_freeze_date}. The protocol is rendered below as frozen, so the words "draft" and "not frozen" in its text are part of that frozen record. Departures since are logged in the `} p={`). The text below is the fixed version, so where it says "draft" it is quoting itself as it was then. Any change since is logged in the `} /><a href={devUrl}><L t="deviations register" p="list of changes" /></a>.</p>
      <Layer><Fragment slot="t"><div class="prose" set:html={md(protocol, 'docs/plans')} /></Fragment><Fragment slot="p"><p>Which data go in is decided by rules written down in advance, for each cell of the grid: the data must measure the right thing for that kind of object, be public and readable by computer, not rest on a shortcut formula for the observed pull, be allowed to be shared or checked by fingerprint, and add something new. The search for data is logged. Every dataset that meets the rules is included; nobody picks by taste, and nobody plots a candidate before deciding whether it qualifies. A cell counts as a gap only if the search found nothing usable, or a request went unanswered for eight weeks. Any departure from the rules is logged with the reason.</p></Fragment></Layer>
      <h2 id="gate"><L t="Release gate" p="When v1.0 is published" /></h2>
      <p class="boxed"><L t="Narrowed on 2026-11-05 by " p="Changed on 5 November 2026 (" /><a href={d110}>D-110</a><L t=" (deviation #23 in the " p=", see the " /><a href={devUrl}><L t="deviations register" p="list of changes" /></a><L t="): v1.0 is the datasets in hand plus the data freeze, the standard 3.0.0 re-issue, the formal outside review and the methods paper. Filling the remaining cells moves to v1.x releases, and unfilled cells are shown as documented gaps. The gate below is the frozen text as written and no longer defines v1.0." p="): v1.0 will be the data already in, checked, re-issued to a stricter standard and reviewed by outside experts, plus a methods paper. The remaining kinds follow in later updates. The rule below is the original, kept as written." /></p>
      <Layer><Fragment slot="t"><div class="prose" set:html={md(gate, 'docs/plans')} /></Fragment><Fragment slot="p"><p>As first written, the full first release would come out when every cell of the grid either holds data or is shown as a gap, and the Atlas covered: the strong-pull end of the range (the Solar System and old star clusters); the objects with the weakest pull from detected matter (small faint galaxies); at least one kind of galaxy besides spinning discs; both ways of measuring (motions and light-bending); at least two views of the data; the cross-checks and how far the data reach; and a plain statement that earlier cosmic times are not yet covered.</p></Fragment></Layer>
      <p class="small"><L t="Source of this page:" p="Full document:" /> <a href={`${REPO}/blob/main/docs/plans/TAXONOMY_v2.md`}>docs/plans/TAXONOMY_v2.md</a> (version 2, D-108; <a href={`${REPO}/blob/main/docs/plans/TAXONOMY.md`}>version 1</a>) · <a href={`${REPO}/blob/main/docs/sources/survey-2026-10-28.md`}>source survey</a></p>
    </main>
    <aside class="toc"><p class="cap">On this page</p><a href="#in-hand">In hand now</a><a href="#kinds">Kinds</a><a href="#matrix">Coverage matrix</a><a href="#continuous">Continuous axes</a><a href="#epoch-gap">Epoch gap</a><a href="#selection">Selection protocol</a><a href="#gate">Release gate</a></aside>
  </div>
</Base>
