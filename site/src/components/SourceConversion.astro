---
// "Source and conversion" on a dataset page. A package with a SOURCE.md shows it. A package without
// one shows what its own method files record: the files read (sources.json, with hashes), the
// selection and the detected matter counted (datapackage.json), the second reading, and links to the
// frozen test and the conversion script. Nothing is written here that the package does not state.
import fs from 'node:fs';
import path from 'node:path';
import Layer from './Layer.astro';
import L from './L.astro';
import { md, REPO } from '../lib/md.mjs';
import { ROOT } from '../lib/atlas.mjs';
import { linkRefs } from '../lib/refs.mjs';
const { d, repoDir } = Astro.props;
const blob = (f) => `${REPO}/blob/main/${repoDir}/${f}`;
const has = (f) => fs.existsSync(path.join(ROOT, repoDir, f));
const files = [
  ['REPRODUCTION.md', 'Frozen reproduction test (states the method and what it must reproduce)'],
  ['REPRODUCTION_REV3.md', 'Re-issued frozen test (D-103)'],
  ['REPRODUCTION_PART_B.md', 'Frozen test, part B'],
  ['convert.py', 'Conversion script'],
  ['datapackage.json', 'Package descriptor: selection, detected matter counted, columns'],
  ['sources.json', 'Files read, with addresses, dates and SHA-256 hashes'],
  ['SECOND_READING.md', 'Independent second reading'],
].filter(([f]) => has(f));
const hasReading = fs.existsSync(path.join(ROOT, repoDir, 'reading'));
const sources = (d.sources && d.sources.sources) || [];
const sel = Array.isArray(d.dp.x_selection) ? d.dp.x_selection : [];
const inv = Array.isArray(d.dp.x_baryon_inventory) ? d.dp.x_baryon_inventory : [];
const second = d.dp.x_second_reading;
const status = (s) => String(s || '').replace(/_/g, ' ');
const shortHash = (h) => (h ? `${h.slice(0, 12)}…` : '–');
// Package wording that uses a term the Atlas does not use as description (audit finding T4) is not
// repeated here; it stays in the package file and changes at re-issue.
const T4 = /\b(halo(e?s)?|dark\s+matter)\b/i;
const invText = (x) => { const t = x.citation || x.note || ''; return T4.test(t) ? null : t; };
---
{d.md.source ? (
  <>
    <Layer as="p" class="small"><Fragment slot="t">The package’s source note (<a href={blob('SOURCE.md')}>SOURCE.md</a>), as written:</Fragment><Fragment slot="p">The notes below record what was read from the original study, when, and how the numbers were worked out. They are technical; the summary at the top of this page gives the gist.</Fragment></Layer>
    <div class="prose" set:html={md(d.md.source, repoDir)} />
  </>
) : (
  <>
    <Layer as="p"><Fragment slot="t">This package has no separate source note (SOURCE.md). What was read at source and how it was converted are recorded in the package’s own files, summarised below from them: the files read, the selection, the detected matter counted, and the second reading.</Fragment><Fragment slot="p">These are the published studies and files the numbers were taken from. Each file has a fingerprint (a hash), so anyone can check it is the same file. The steps of the conversion are written out in the package files linked here.</Fragment></Layer>
    <ul class="small">
      {files.map(([f, t]) => <li><a href={blob(f)}>{f}</a>: {t}</li>)}
      {hasReading && <li><a href={`${REPO}/tree/main/${repoDir}/reading`}>reading/</a>: the readings at source, with their quotations</li>}
    </ul>

    {sources.length > 0 && <>
      <h3><L t={`Files read (${sources.length})`} p={`Files the numbers come from (${sources.length})`} /></h3>
      <details open={sources.length <= 12}><summary class="small"><L t="Role, address, date retrieved and SHA-256 of each file, from sources.json" p="Show the list" /></summary>
        <div class="tablebox" tabindex="0"><table><thead><tr><th class="l">Role</th><th class="l">Retrieved</th><th class="l">SHA-256</th><th class="l">Copy in the repository</th></tr></thead><tbody>
          {sources.map((s) => <tr>
            <td class="l" style="white-space:normal;min-width:260px">{s.url ? <a href={s.url}>{s.role || s.file}</a> : (s.role || s.file)}{s.note && <><br><span class="small" set:html={linkRefs(s.note, repoDir)} /></>}</td>
            <td class="l">{s.retrieved || '–'}</td>
            <td class="l"><code style="font-size:11px" title={s.sha256 || ''}>{shortHash(s.sha256)}</code></td>
            <td class="l">{s.redistributable ? 'yes' : 'no: fetched by address and checked by hash'}</td>
          </tr>)}
        </tbody></table></div>
      </details>
    </>}

    {sel.length > 0 && <>
      <h3><L t="Selection" p="Which systems and values are used" /></h3>
      <ul class="small">{sel.map((x) => <li>{x.sample && <>{status(x.sample)}: </>}<b>{x.quantity}</b> {x.condition === '==' ? '' : `${x.condition} `}<span set:html={linkRefs(String(x.value ?? ''), repoDir)} />{x.citation && <> (<span set:html={linkRefs(x.citation, repoDir)} />)</>}</li>)}</ul>
    </>}

    {inv.length > 0 && <>
      <h3><L t="Detected matter counted in g_bar" p="Which matter goes into the pull from detected matter" /></h3>
      <ul class="small">{inv.map((x) => <li><b>{x.component}</b>: {status(x.status)}{invText(x) ? <>. <span set:html={linkRefs(invText(x), repoDir)} /></> : (x.citation || x.note) && <>. The package’s note for this component is in <a href={blob('datapackage.json')}>datapackage.json</a>; its wording is corrected at re-issue (audit finding T4).</>}</li>)}</ul>
      {d.dp.x_baryon_inventory_note && <p class="small" set:html={linkRefs(d.dp.x_baryon_inventory_note, repoDir)} />}
    </>}

    {second && <>
      <h3><L t="Second reading" p="Checked by a second reader" /></h3>
      {typeof second === 'string' ? <p class="small"><a href={blob(second)}>{second}</a></p> : <p class="small">
        {second.by && <>By {second.by}. </>}{second.date && <>{second.date}. </>}{second.result && <span set:html={linkRefs(second.result, repoDir)} />}{second.file && <> <a href={blob(second.file)}>{second.file}</a></>}
      </p>}
    </>}
  </>
)}
