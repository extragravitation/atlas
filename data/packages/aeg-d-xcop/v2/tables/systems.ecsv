# datatype:
# - name: system_id
#   datatype: string
#   description: Atlas system identifier
#   meta: !!omap
#   - {ucd: meta.id;meta.main}
# - name: name_in_source
#   datatype: string
#   description: Cluster name as in Eckert et al. 2022 Table 1
#   meta: !!omap
#   - {ucd: meta.id}
