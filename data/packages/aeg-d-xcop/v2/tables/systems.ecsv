#   datatype: string
#   description: Class as the source gives it
#   meta: !!omap
#   - {ucd: src.class}
# - name: taxonomy_kind
#   datatype: string
#   description: "Taxonomy kind (A0\u2013A10)"
#   meta: !!omap
#   - {ucd: meta.code}
# - name: kind_label
#   datatype: string
#   description: Kind label
#   meta: !!omap
#   - {ucd: meta.note}
# - name: host
#   datatype: string
#   description: Host (none)
#   meta: !!omap
#   - {ucd: meta.id}
# - name: distance_mpc
#   unit: Mpc
#   datatype: float64
#   description: Not given; redshift is given (D-033)
#   meta: !!omap
#   - {ucd: pos.distance}
# - name: distance_method
#   datatype: string
#   description: Distance method (none)
#   meta: !!omap
#   - {ucd: meta.note}
# - name: distance_kinematic
#   datatype: string
#   description: Distance derived from kinematics
#   meta: !!omap
#   - {ucd: meta.code}
# - name: distance_ref
#   datatype: string
#   description: Distance source (none)
#   meta: !!omap
#   - {ucd: meta.ref}
# - name: redshift
#   datatype: float64
#   description: "Redshift, Eckert et al. 2022 Table 1 (part A \xA72)"
#   meta: !!omap
#   - {ucd: src.redshift}
# - name: redshift_err
#   datatype: float64
#   description: Not given
#   meta: !!omap
#   - {ucd: stat.error;src.redshift}
# - name: metallicity_feh
#   datatype: float64
#   description: Not given
#   meta: !!omap
#   - {ucd: phys.abund.Fe}
# - name: properties
#   datatype: string
#   description: 'Source-given properties only: Table 1''s R500,TOT, M500,TOT and M200,TOT (JSON; units in key names)'
#   meta: !!omap
#   - {ucd: meta.note}
# - name: x_xcop_alpha_nt_r500
#   datatype: float64
#   description: Non-thermal pressure fraction at R500, Ettori & Eckert 2022 tab:gamma_beta, last column (the present work, l. 274); unit
#     as printed (per cent inferred, not stated); size of term nonthermal_pressure
#   meta: !!omap
#   - {ucd: phys.pressure;arith.ratio}
# - name: x_xcop_alpha_nt_r500_err_lo
#   datatype: float64
#   description: Printed lower (subscript) error of x_xcop_alpha_nt_r500, sign as printed (anomalous signs not repaired; reading/resolutions.md);
#     1 sigma (l. 276); unit as printed (per cent inferred, not stated)
#   meta: !!omap
#   - {ucd: stat.error}
# - name: x_xcop_alpha_nt_r500_err_hi
#   datatype: float64
#   description: Printed upper (superscript) error of x_xcop_alpha_nt_r500, sign as printed; 1 sigma (l. 276); unit as printed (per cent
#     inferred, not stated)
#   meta: !!omap
#   - {ucd: stat.error}
# - name: x_xcop_alpha_nt_r200
#   datatype: float64
#   description: Non-thermal pressure fraction at R200, as x_xcop_alpha_nt_r500; unit as printed (per cent inferred, not stated); term
#     nonthermal_pressure
#   meta: !!omap
#   - {ucd: phys.pressure;arith.ratio}
# - name: x_xcop_alpha_nt_r200_err_lo
#   datatype: float64
#   description: Printed lower error of x_xcop_alpha_nt_r200, sign as printed (not repaired); unit as printed (per cent inferred, not
#     stated)
#   meta: !!omap
#   - {ucd: stat.error}
# - name: x_xcop_alpha_nt_r200_err_hi
#   datatype: float64
#   description: Printed upper error of x_xcop_alpha_nt_r200, sign as printed; unit as printed (per cent inferred, not stated)
#   meta: !!omap
#   - {ucd: stat.error}
# - name: x_xcop_centroid_w
#   datatype: float64
#   description: "Centroid shift w, Paper II Table 2 (tab2.tex), in 10\u207B\xB3 (as printed); continuous, never a label (part A \xA7\
#     5)"
#   meta: !!omap
#   - {ucd: src.morph.param}
# - name: x_xcop_centroid_w_err
#   datatype: float64
#   description: "Printed \xB1 error of x_xcop_centroid_w, in 10\u207B\xB3 (as printed)"
#   meta: !!omap
#   - {ucd: stat.error}
# - name: x_xcop_mm_gp_ein
#   datatype: float64
#   description: 'Part A A7: non-parametric / Einasto mass at R500 from R3 (result_part_a.json, stored precision); empty for the seven
#     clusters without rows; term mass_model_choice'
#   meta: !!omap
#   - {ucd: phys.mass;arith.ratio}
# - name: x_xcop_mm_gp_nfw
#   datatype: float64
#   description: 'Part A A7: non-parametric mass at R500 from R3 / Table 1 NFW M500 at Table 1''s R500; empty for the seven; term mass_model_choice'
#   meta: !!omap
#   - {ucd: phys.mass;arith.ratio}
# - name: x_xcop_mm_ein_nfw
#   datatype: float64
#   description: 'Part A A7: Einasto mass at R500 from R3 / Table 1 NFW M500 at Table 1''s R500; empty for the seven; term mass_model_choice'
#   meta: !!omap
#   - {ucd: phys.mass;arith.ratio}
# - name: x_xcop_mass_model_frac
#   datatype: float64
#   description: "Size of term mass_model_choice: round(max |r \u2212 1|, 4) over the three x_xcop_mm_* ratios (part B item 7; D-105 O2);\
#     \ Atlas-computed; empty for the seven"
#   meta: !!omap
#   - {ucd: stat.error;arith.ratio}
# - name: x_xcop_status
#   datatype: string
#   description: 'Atlas state: plotted (the five with rows) or recorded_not_plotted (the seven without stellar data; part B rule 2)'
#   meta: !!omap
#   - {ucd: meta.code}
# delimiter: ','
# meta: !!omap
# - {dataset: aeg-d-xcop}
# - {version: v2}
# - {standard_version: 2.5.1}
