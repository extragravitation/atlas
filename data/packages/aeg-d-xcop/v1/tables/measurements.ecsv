# %ECSV 1.0
# ---
# datatype:
# - name: measurement_id
#   datatype: string
#   description: Permanent measurement identifier
#   meta: !!omap
#   - {ucd: meta.id;meta.main}
# - name: system_id
#   datatype: string
#   description: Atlas system identifier
#   meta: !!omap
#   - {ucd: meta.id}
# - name: kind
#   datatype: string
#   description: Kind of measurement
#   meta: !!omap
#   - {ucd: meta.code}
# - name: channel
#   datatype: string
#   description: Observational channel
#   meta: !!omap
#   - {ucd: meta.code}
# - name: method_class
#   datatype: string
#   description: Class of method
#   meta: !!omap
#   - {ucd: meta.code.class}
# - name: method
#   datatype: string
#   description: Method as given by the source
#   meta: !!omap
#   - {ucd: meta.note}
# - name: r_kpc
#   unit: kpc
#   datatype: float64
#   description: Three-dimensional radius, from the source's hydrostatic-mass grid
#   meta: !!omap
#   - {ucd: phys.size.radius}
# - name: r_kind
#   datatype: string
#   description: Radius is three-dimensional
#   meta: !!omap
#   - {ucd: meta.code}
# - name: g_obs
#   unit: m / s2
#   datatype: float64
#   description: Observed acceleration, G M_forward(<r) / r^2
#   meta: !!omap
#   - {ucd: phys.acceleration}
# - name: g_obs_err_lo
#   unit: m / s2
#   datatype: float64
#   description: One-sigma error, from the source's forward-method mass error
#   meta: !!omap
#   - {ucd: stat.error;phys.acceleration}
# - name: g_obs_err_hi
#   unit: m / s2
#   datatype: float64
#   description: One-sigma error, from the source's forward-method mass error
#   meta: !!omap
#   - {ucd: stat.error;phys.acceleration}
# - name: g_bar
#   unit: m / s2
#   datatype: float64
#   description: Baryonic acceleration, G (M_gas + M_stars)(<r) / r^2
#   meta: !!omap
#   - {ucd: phys.acceleration}
# - name: g_bar_err_lo
#   unit: m / s2
#   datatype: float64
#   description: Gas and measured-star errors in quadrature; modelled stars carry no error
#   meta: !!omap
#   - {ucd: stat.error;phys.acceleration}
# - name: g_bar_err_hi
#   unit: m / s2
#   datatype: float64
#   description: Gas and measured-star errors in quadrature; modelled stars carry no error
#   meta: !!omap
#   - {ucd: stat.error;phys.acceleration}
# - name: g_bar_stars
#   unit: m / s2
#   datatype: float64
#   description: Stellar component of g_bar (measured or modelled, see stars_status)
#   meta: !!omap
#   - {ucd: phys.acceleration}
# - name: g_bar_gas_hot
#   unit: m / s2
#   datatype: float64
#   description: Hot-gas component of g_bar, from the X-ray gas mass
#   meta: !!omap
#   - {ucd: phys.acceleration}
# - name: stars_status
#   datatype: string
#   description: Stars measured (Ghizzardi et al. 2020) or modelled (D-022)
#   meta: !!omap
#   - {ucd: meta.code}
# - name: gas_cold_status
#   datatype: string
#   description: Cold gas not included by the source
#   meta: !!omap
#   - {ucd: meta.code}
# - name: gas_hot_status
#   datatype: string
#   description: Hot gas measured from X-ray emission
#   meta: !!omap
#   - {ucd: meta.code}
# - name: assumptions
#   datatype: string
#   description: Named assumptions affecting this row
#   meta: !!omap
#   - {ucd: meta.note}
# - name: adjustable
#   datatype: string
#   description: Assumptions whose sliders can change this row
#   meta: !!omap
#   - {ucd: meta.note}
# - name: source_ref
#   datatype: string
#   description: Pointer to the source file and row
#   meta: !!omap
#   - {ucd: meta.ref}
# - name: flags
#   datatype: string
#   description: Atlas flags
#   meta: !!omap
#   - {ucd: meta.code}
# - name: known_issues
#   datatype: string
#   description: Open known issues affecting this row (GitHub issue numbers)
#   meta: !!omap
#   - {ucd: meta.ref}
# - name: x_xcop_m_forw
#   unit: solMass
#   datatype: float64
#   description: Forward-method hydrostatic mass within r, as released
#   meta: !!omap
#   - {ucd: phys.mass}
# - name: x_xcop_m_gas
#   unit: solMass
#   datatype: float64
#   description: Gas mass within r, interpolated in log-log from the release
#   meta: !!omap
#   - {ucd: phys.mass}
# - name: x_xcop_m_star
#   unit: solMass
#   datatype: float64
#   description: 'Stellar mass within r: interpolated from the release, or modelled (D-022)'
#   meta: !!omap
#   - {ucd: phys.mass}
# - name: x_xcop_g_bar_gas_err_lo
#   unit: m / s2
#   datatype: float64
#   description: Lower one-sigma error of the gas component
#   meta: !!omap
#   - {ucd: stat.error;phys.acceleration}
# - name: x_xcop_g_bar_gas_err_hi
#   unit: m / s2
#   datatype: float64
#   description: Upper one-sigma error of the gas component
#   meta: !!omap
#   - {ucd: stat.error;phys.acceleration}
# - name: x_xcop_g_bar_stars_err_lo
#   unit: m / s2
#   datatype: float64
#   description: Lower error of measured stars (total uncertainty as released); empty if modelled
#   meta: !!omap
#   - {ucd: stat.error;phys.acceleration}
# - name: x_xcop_g_bar_stars_err_hi
#   unit: m / s2
#   datatype: float64
#   description: Upper error of measured stars (total uncertainty as released); empty if modelled
#   meta: !!omap
#   - {ucd: stat.error;phys.acceleration}
# delimiter: ','
# meta: !!omap
# - {dataset: aeg-d-xcop}
# - {version: v1}
# - {standard_version: 1.2.1}
# schema: astropy-2.0
