#   datatype: float64
#   description: Fraction of the King-model light inside the bins
#   meta: !!omap
#   - {ucd: stat.fit.param}
# - name: x_gc_baumgardt_n_bins
#   datatype: int64
#   description: Number of bins
#   meta: !!omap
#   - {ucd: meta.number}
# - name: x_gc_baumgardt_r_h_pc
#   unit: pc
#   datatype: float64
#   description: Projected half-light radius at the Harris distance
#   meta: !!omap
#   - {ucd: phys.size.radius}
# - name: x_gc_baumgardt_l_v
#   unit: solLum
#   datatype: float64
#   description: V-band luminosity from Harris M_V,t, M_V,sun = 4.85
#   meta: !!omap
#   - {ucd: phys.luminosity}
# - name: x_gc_baumgardt_ml_v
#   unit: solMass / solLum
#   datatype: float64
#   description: Population M/L_V (BC03, Chabrier disk IMF)
#   meta: !!omap
#   - {ucd: phys.composition.massLightRatio}
# - name: x_gc_baumgardt_ml_v_salpeter
#   unit: solMass / solLum
#   datatype: float64
#   description: Population M/L_V with a Salpeter IMF (BC03), the D-039 upper bound
#   meta: !!omap
#   - {ucd: phys.composition.massLightRatio}
# - name: x_gc_baumgardt_distance_kpc
#   unit: kpc
#   datatype: float64
#   description: Harris distance
#   meta: !!omap
#   - {ucd: pos.distance}
