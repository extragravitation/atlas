#   datatype: string
#   description: Dataset code of the profile in veldis.html
#   meta: !!omap
#   - {ucd: meta.id}
# - name: x_gc_baumgardt_sigma
#   unit: km / s
#   datatype: float64
#   description: "Light-weighted line-of-sight dispersion \u03C3_rms"
#   meta: !!omap
#   - {ucd: phys.veloc.dispersion}
# - name: x_gc_baumgardt_sigma_err_lo
#   unit: km / s
#   datatype: float64
#   description: "Lower one-sigma error of \u03C3_rms"
#   meta: !!omap
#   - {ucd: stat.error;phys.veloc.dispersion}
# - name: x_gc_baumgardt_sigma_err_hi
#   unit: km / s
#   datatype: float64
#   description: "Upper one-sigma error of \u03C3_rms"
#   meta: !!omap
#   - {ucd: stat.error;phys.veloc.dispersion}
