# datatype:
# - name: observable_id
#   datatype: string
#   description: Permanent observable identifier
#   meta: !!omap
#   - {ucd: meta.id;meta.main}
# - name: system_id
#   datatype: string
#   description: Atlas system identifier
#   meta: !!omap
#   - {ucd: meta.id}
# - name: side
#   datatype: string
#   description: Observed or baryonic side
#   meta: !!omap
#   - {ucd: meta.code}
# - name: quantity
#   datatype: string
#   description: Quantity (closed list, data standard 2.0)
#   meta: !!omap
#   - {ucd: meta.code}
# - name: value
#   datatype: float64
#   description: Value as printed by the source
#   meta: !!omap
#   - {ucd: meta.number}
# - name: err_lo
#   datatype: float64
#   description: Lower error as printed
#   meta: !!omap
#   - {ucd: stat.error}
# - name: err_hi
#   datatype: float64
#   description: Upper error as printed
#   meta: !!omap
#   - {ucd: stat.error}
# - name: unit
#   datatype: string
#   description: Unit of value
#   meta: !!omap
#   - {ucd: meta.unit}
# - name: band
#   datatype: string
#   description: Photometric band
#   meta: !!omap
#   - {ucd: instr.bandpass}
# - name: limit
#   datatype: string
#   description: Whether the value is a limit
#   meta: !!omap
#   - {ucd: meta.code}
# - name: r_kpc
#   unit: kpc
#   datatype: float64
#   description: Projected radius of the bin at the Harris distance
#   meta: !!omap
#   - {ucd: pos.distance;phys.size.radius}
# - name: r_kind
#   datatype: string
#   description: Radius kind
#   meta: !!omap
#   - {ucd: meta.code}
# - name: steps
#   datatype: string
#   description: Processing ladder from data to this quantity
#   meta: !!omap
#   - {ucd: meta.note}
# - name: evidence_tier
#   datatype: int64
#   description: Evidence tier (D-035)
#   meta: !!omap
#   - {ucd: meta.code.qual}
# - name: source_ref
#   datatype: string
#   description: Source file and row
#   meta: !!omap
#   - {ucd: meta.ref}
# - name: x_gc_baumgardt_r_arcsec
#   unit: arcsec
#   datatype: float64
#   description: Mean projected radius of the bin, as printed
#   meta: !!omap
#   - {ucd: pos.angDistance}
# - name: x_gc_baumgardt_n_star
#   datatype: float64
#   description: Stars in the bin, as printed (empty for IFU data)
#   meta: !!omap
#   - {ucd: meta.number}
# - name: x_gc_baumgardt_dataset
#   datatype: string
#   description: Dataset code in veldis.html
#   meta: !!omap
#   - {ucd: meta.id}
# - name: x_gc_baumgardt_parameter
#   datatype: string
#   description: Which source parameter this row is
#   meta: !!omap
#   - {ucd: meta.note}
# delimiter: ','
# meta: !!omap
