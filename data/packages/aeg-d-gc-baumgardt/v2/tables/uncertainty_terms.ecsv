# %ECSV 1.0
# ---
# datatype:
# - name: term_id
#   datatype: string
#   description: Term identifier
#   meta: !!omap
#   - {ucd: meta.id}
# - name: scale
#   datatype: string
#   description: "point, system or dataset (standard 2.2.0 \xA72a)"
#   meta: !!omap
#   - {ucd: meta.code}
# - name: applies_to
#   datatype: string
#   description: System, or * for all
#   meta: !!omap
#   - {ucd: meta.id}
# - name: moves
#   datatype: string
#   description: Axes the term moves
#   meta: !!omap
#   - {ucd: meta.code}
# - name: status
#   datatype: string
#   description: given, given_by_other_source or not_given_by_source
#   meta: !!omap
#   - {ucd: meta.code}
# - name: size_value
#   datatype: float64
#   description: Size as the source states it
#   meta: !!omap
#   - {ucd: stat.error}
# - name: size_lo
#   datatype: float64
#   description: Lower end of a published range
#   meta: !!omap
#   - {ucd: stat.min}
# - name: size_hi
#   datatype: float64
#   description: Upper end of a published range
#   meta: !!omap
#   - {ucd: stat.max}
# - name: size_unit
#   datatype: string
#   description: Unit of the size
#   meta: !!omap
#   - {ucd: meta.unit}
# - name: size_column
#   datatype: string
#   description: "Systems or measurements column holding a per-system or per-row size (standard 2.5.1 \xA712)"
#   meta: !!omap
#   - {ucd: meta.ref}
# - name: size_kind
#   datatype: string
#   description: one_sigma, range, as_released, upper_bound or lower_bound
#   meta: !!omap
#   - {ucd: meta.code}
# - name: assumption_id
#   datatype: string
#   description: Registry assumption whose formula moves the values
#   meta: !!omap
#   - {ucd: meta.id}
# - name: correlated_with
#   datatype: string
#   description: Correlated terms
#   meta: !!omap
#   - {ucd: meta.note}
# - name: covariance
#   datatype: string
#   description: published, not_published or not_applicable
#   meta: !!omap
#   - {ucd: meta.code}
# - name: citation
#   datatype: string
#   description: Where the size was read
#   meta: !!omap
#   - {ucd: meta.bib}
# - name: locator
#   datatype: string
#   description: Section, table, line or quote
#   meta: !!omap
#   - {ucd: meta.ref}
# - name: note
#   datatype: string
#   description: What the term is
#   meta: !!omap
#   - {ucd: meta.note}
# - name: in_error_columns
#   datatype: string
#   description: 'yes or no: whether the term is inside the error columns'
#   meta: !!omap
#   - {ucd: meta.code}
# delimiter: ','
# meta: !!omap
# - {dataset: aeg-d-gc-baumgardt}
# - {version: v2}
# - {standard_version: 2.5.1}
# schema: astropy-2.0
