# %ECSV 1.0
# ---
# datatype:
# - name: measurement_id
#   datatype: string
#   description: Permanent measurement identifier
#   meta: !!omap
#   - {ucd: meta.id;meta.main}
# - name: system_id
#   datatype: string
#   description: Permanent system identifier
#   meta: !!omap
#   - {ucd: meta.id}
# - name: kind
#   datatype: string
#   description: Kind of measurement
#   meta: !!omap
#   - {ucd: meta.code}
# - name: channel
#   datatype: string
#   description: Observational channel
#   meta: !!omap
#   - {ucd: meta.code}
# - name: method_class
#   datatype: string
#   description: Class of method
#   meta: !!omap
#   - {ucd: meta.code.class}
# - name: method
#   datatype: string
#   description: Method as given by the source
#   meta: !!omap
#   - {ucd: meta.note}
# - name: r_kpc
#   unit: kpc
#   datatype: float64
#   description: Galactocentric radius in the disc plane
#   meta: !!omap
#   - {ucd: phys.size.radius}
# - name: r_kind
#   datatype: string
#   description: Radius type
#   meta: !!omap
#   - {ucd: meta.code}
# - name: g_obs
#   unit: m / s2
#   datatype: float64
#   description: Observed acceleration, V_obs^2/R
#   meta: !!omap
#   - {ucd: phys.acceleration}
# - name: g_obs_err_lo
#   unit: m / s2
#   datatype: float64
#   description: Lower one-sigma bound (velocity, inclination and distance errors)
#   meta: !!omap
#   - {ucd: stat.error;phys.acceleration}
# - name: g_obs_err_hi
#   unit: m / s2
#   datatype: float64
#   description: Upper one-sigma bound (velocity, inclination and distance errors)
#   meta: !!omap
#   - {ucd: stat.error;phys.acceleration}
# - name: g_bar
#   unit: m / s2
#   datatype: float64
#   description: Newtonian acceleration from detected baryons at catalogue defaults
#   meta: !!omap
#   - {ucd: phys.acceleration;meta.modelled}
# - name: g_bar_err_lo
#   unit: m / s2
#   datatype: float64
#   description: Lower one-sigma bound (10% gas, 25% stellar, per source)
#   meta: !!omap
#   - {ucd: stat.error;phys.acceleration}
# - name: g_bar_err_hi
#   unit: m / s2
#   datatype: float64
#   description: Upper one-sigma bound (10% gas, 25% stellar, per source)
#   meta: !!omap
#   - {ucd: stat.error;phys.acceleration}
# - name: g_bar_stars
#   unit: m / s2
#   datatype: float64
#   description: Stellar component of g_bar
#   meta: !!omap
#   - {ucd: phys.acceleration;meta.modelled}
# - name: g_bar_stars_disk
#   unit: m / s2
#   datatype: float64
#   description: Stellar disc component of g_bar
#   meta: !!omap
#   - {ucd: phys.acceleration;meta.modelled}
# - name: g_bar_stars_bulge
#   unit: m / s2
#   datatype: float64
#   description: Bulge component of g_bar; empty where the source has no bulge
#   meta: !!omap
#   - {ucd: phys.acceleration;meta.modelled}
# - name: g_bar_gas_cold
#   unit: m / s2
#   datatype: float64
#   description: Cold gas (atomic hydrogen with helium) component of g_bar; sign kept
#   meta: !!omap
#   - {ucd: phys.acceleration;meta.modelled}
# - name: g_bar_gas_hot
#   unit: m / s2
#   datatype: float64
#   description: Hot gas component of g_bar; not given by the source
#   meta: !!omap
#   - {ucd: phys.acceleration;meta.modelled}
# - name: stars_status
#   datatype: string
#   description: Status of the stellar component
#   meta: !!omap
#   - {ucd: meta.code}
# - name: gas_cold_status
#   datatype: string
#   description: Status of the cold gas component
#   meta: !!omap
#   - {ucd: meta.code}
# - name: gas_hot_status
#   datatype: string
#   description: Status of the hot gas component
#   meta: !!omap
#   - {ucd: meta.code}
# - name: assumptions
#   datatype: string
#   description: Named assumptions affecting this row, with catalogue values
#   meta: !!omap
#   - {ucd: meta.note}
# - name: adjustable
#   datatype: string
#   description: Assumptions whose sliders can change this row
#   meta: !!omap
#   - {ucd: meta.note}
# - name: quality_source
#   datatype: string
#   description: Source's rotation-curve quality flag (1 high, 2 medium, 3 low)
#   meta: !!omap
#   - {ucd: meta.code.qual}
# - name: source_ref
#   datatype: string
#   description: Pointer to the source row
#   meta: !!omap
#   - {ucd: meta.ref}
# - name: flags
#   datatype: string
#   description: Atlas flags
#   meta: !!omap
#   - {ucd: meta.code}
# - name: x_sparc_v_obs
#   unit: km / s
#   datatype: float64
#   description: SPARC Vobs, as published
#   meta: !!omap
#   - {ucd: phys.veloc.rotat}
# - name: x_sparc_e_v_obs
#   unit: km / s
#   datatype: float64
#   description: SPARC e_Vobs, as published
#   meta: !!omap
#   - {ucd: stat.error;phys.veloc.rotat}
# - name: x_sparc_v_gas
#   unit: km / s
#   datatype: float64
#   description: SPARC Vgas, as published (includes helium factor 1.33)
#   meta: !!omap
#   - {ucd: phys.veloc.rotat;meta.modelled}
# - name: x_sparc_v_disk
#   unit: km / s
#   datatype: float64
#   description: SPARC Vdisk, as published (for M/L = 1 at 3.6 micron)
#   meta: !!omap
#   - {ucd: phys.veloc.rotat;meta.modelled}
# - name: x_sparc_v_bul
#   unit: km / s
#   datatype: float64
#   description: SPARC Vbul, as published (for M/L = 1 at 3.6 micron)
#   meta: !!omap
#   - {ucd: phys.veloc.rotat;meta.modelled}
# delimiter: ','
# meta: !!omap
# - {dataset: aeg-d-sparc}
# - {version: v1}
# - {standard_version: 1.1.0}
# schema: astropy-2.0
