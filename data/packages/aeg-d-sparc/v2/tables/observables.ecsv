# %ECSV 1.0
# ---
# datatype:
# - name: observable_id
#   datatype: string
#   description: Permanent observable identifier
#   meta: !!omap
#   - {ucd: meta.id;meta.main}
# - name: system_id
#   datatype: string
#   description: Permanent system identifier
#   meta: !!omap
#   - {ucd: meta.id}
# - name: side
#   datatype: string
#   description: observed or baryonic
#   meta: !!omap
#   - {ucd: meta.code}
# - name: quantity
#   datatype: string
#   description: "Quantity (standard \xA74a)"
#   meta: !!omap
#   - {ucd: meta.code}
# - name: value
#   datatype: float64
#   description: Value as the source gives it
#   meta: !!omap
#   - {ucd: meta.number}
# - name: err_lo
#   datatype: float64
#   description: Lower error as the source gives it; empty if none
#   meta: !!omap
#   - {ucd: stat.error}
# - name: err_hi
#   datatype: float64
#   description: Upper error as the source gives it; empty if none
#   meta: !!omap
#   - {ucd: stat.error}
# - name: unit
#   datatype: string
#   description: Unit of value and errors
#   meta: !!omap
#   - {ucd: meta.unit}
# - name: band
#   datatype: string
#   description: Photometric band for stellar quantities
#   meta: !!omap
#   - {ucd: instr.bandpass}
# - name: limit
#   datatype: string
#   description: Limit
#   meta: !!omap
#   - {ucd: meta.code}
# - name: r_kpc
#   unit: kpc
#   datatype: float64
#   description: Radius of the value
#   meta: !!omap
#   - {ucd: phys.size.radius}
# - name: r_kind
#   datatype: string
#   description: Radius type
#   meta: !!omap
#   - {ucd: meta.code}
# - name: steps
#   datatype: string
#   description: "Processing steps the source performed (standard \xA74b)"
#   meta: !!omap
#   - {ucd: meta.note}
# - name: evidence_tier
#   datatype: int64
#   description: 1 released files
#   meta: !!omap
#   - {ucd: meta.code.qual}
# - name: source_ref
#   datatype: string
#   description: Pointer to the source row and column
#   meta: !!omap
#   - {ucd: meta.ref}
# delimiter: ','
# meta: !!omap
# - {dataset: aeg-d-sparc}
# - {version: v2}
# - {standard_version: 2.3.0}
# schema: astropy-2.0
