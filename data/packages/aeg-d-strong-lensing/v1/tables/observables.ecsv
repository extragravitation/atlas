# %ECSV 1.0
# ---
# datatype:
# - name: observable_id
#   datatype: string
#   description: Observable identifier
#   meta: !!omap
#   - {ucd: meta.id;meta.main}
# - name: system_id
#   datatype: string
#   description: Atlas system identifier
#   meta: !!omap
#   - {ucd: meta.id}
# - name: side
#   datatype: string
#   description: observed or baryonic
#   meta: !!omap
#   - {ucd: meta.code}
# - name: quantity
#   datatype: string
#   description: "Data standard 2.1.0 \xA74a"
#   meta: !!omap
#   - {ucd: meta.code}
# - name: value
#   datatype: float64
#   description: Value in the unit of the row (log values converted to linear)
#   meta: !!omap
#   - {ucd: meta.number}
# - name: err_lo
#   datatype: float64
#   description: Lower error, same unit
#   meta: !!omap
#   - {ucd: stat.error}
# - name: err_hi
#   datatype: float64
#   description: Upper error, same unit
#   meta: !!omap
#   - {ucd: stat.error}
# - name: unit
#   datatype: string
#   description: Astropy unit string
#   meta: !!omap
#   - {ucd: meta.unit}
# - name: band
#   datatype: string
#   description: Photometric band as the source names it
#   meta: !!omap
#   - {ucd: instr.bandpass}
# - name: limit
#   datatype: string
#   description: none
#   meta: !!omap
#   - {ucd: meta.code}
# - name: steps
#   datatype: string
#   description: "Ladder steps (data standard \xA74b)"
#   meta: !!omap
#   - {ucd: meta.note}
# - name: evidence_tier
#   datatype: int64
#   description: D-035
#   meta: !!omap
#   - {ucd: meta.code.qual}
# - name: source_ref
#   datatype: string
#   description: Record, location and address
#   meta: !!omap
#   - {ucd: meta.ref}
# - name: x_strong_lensing_parameter
#   datatype: string
#   description: Reading note, or the alternative it is
#   meta: !!omap
#   - {ucd: meta.note}
# - name: x_strong_lensing_role
#   datatype: string
#   description: Role of the input row (D-075, D-076)
#   meta: !!omap
#   - {ucd: meta.code}
# - name: x_strong_lensing_printed
#   datatype: string
#   description: 'As printed: value, errors, form and unit'
#   meta: !!omap
#   - {ucd: meta.note}
# delimiter: ','
# meta: !!omap
# - {dataset: aeg-d-strong-lensing}
# - {version: v1}
# - {standard_version: 2.1.0}
# schema: astropy-2.0
