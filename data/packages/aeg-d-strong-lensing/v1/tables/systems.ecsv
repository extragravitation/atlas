# %ECSV 1.0
# ---
# datatype:
# - name: system_id
#   datatype: string
#   description: Atlas system identifier
#   meta: !!omap
#   - {ucd: meta.id;meta.main}
# - name: name_in_source
#   datatype: string
#   description: Name as printed by the source
#   meta: !!omap
#   - {ucd: meta.id}
# - name: class_in_source
#   datatype: string
#   description: Source's own kind label
#   meta: !!omap
#   - {ucd: src.class}
# - name: taxonomy_kind
#   datatype: string
#   description: A0-A10 (D-063 item 6)
#   meta: !!omap
#   - {ucd: meta.code}
# - name: kind_label
#   datatype: string
#   description: Kind in words
#   meta: !!omap
#   - {ucd: meta.note}
# - name: host
#   datatype: string
#   description: Host system (none)
#   meta: !!omap
#   - {ucd: meta.id}
# - name: redshift
#   datatype: float64
#   description: Lens redshift as printed (default record)
#   meta: !!omap
#   - {ucd: src.redshift}
# - name: redshift_err
#   datatype: float64
#   description: As printed
#   meta: !!omap
#   - {ucd: stat.error;src.redshift}
# - name: distance_kinematic
#   datatype: string
#   description: 'false: spectroscopic redshifts, no kinematic distance'
#   meta: !!omap
#   - {ucd: meta.code}
# - name: distance_ref
#   datatype: string
#   description: Where the lens redshift was read
#   meta: !!omap
#   - {ucd: meta.ref}
# - name: properties
#   datatype: string
#   description: Scope, status, reasons not plotted, z_s, gas statement, flags (JSON)
#   meta: !!omap
#   - {ucd: meta.note}
# delimiter: ','
# meta: !!omap
# - {dataset: aeg-d-strong-lensing}
# - {version: v1}
# - {standard_version: 2.1.0}
# schema: astropy-2.0
system_id,name_in_source,class_in_source,taxonomy_kind,kind_label,host,redshift,redshift_err,distance_kinematic,distance_ref,properties
