# %ECSV 1.0
# ---
# datatype:
# - name: measurement_id
#   datatype: string
#   description: Measurement identifier (D-006)
#   meta: !!omap
#   - {ucd: meta.id;meta.main}
# - name: system_id
#   datatype: string
#   description: Atlas system identifier (data/registry/systems.csv)
#   meta: !!omap
#   - {ucd: meta.id}
# - name: kind
#   datatype: string
#   description: 'system_value: one value per system'
#   meta: !!omap
#   - {ucd: meta.code}
# - name: channel
#   datatype: string
#   description: lensing
#   meta: !!omap
#   - {ucd: meta.code}
# - name: method_class
#   datatype: string
#   description: lensing
#   meta: !!omap
#   - {ucd: meta.code}
# - name: method
#   datatype: string
#   description: How g_obs and g_bar were obtained
#   meta: !!omap
#   - {ucd: meta.note}
# - name: measured_quantity
#   datatype: string
#   description: g_obs
#   meta: !!omap
#   - {ucd: meta.code}
# - name: r_kpc
#   unit: kpc
#   datatype: float64
#   description: Einstein radius R_E (projected)
#   meta: !!omap
#   - {ucd: phys.size.radius}
# - name: r_kind
#   datatype: string
#   description: 'projected (D-064): never merged with 3D values'
#   meta: !!omap
#   - {ucd: meta.code}
# - name: g_obs
#   unit: m / s2
#   datatype: float64
#   description: Observed acceleration in projection, G M_E / R_E^2 (D-064)
#   meta: !!omap
#   - {ucd: phys.acceleration}
# - name: g_obs_err_lo
#   unit: m / s2
#   datatype: float64
#   description: From the M_E error at fixed R_E
#   meta: !!omap
#   - {ucd: stat.error;phys.acceleration}
# - name: g_obs_err_hi
#   unit: m / s2
#   datatype: float64
#   description: From the M_E error at fixed R_E
#   meta: !!omap
#   - {ucd: stat.error;phys.acceleration}
# - name: g_bar
#   unit: m / s2
#   datatype: float64
#   description: Baryonic acceleration in projection, G (M*(<R_E) + M_gas(<R_E)) / R_E^2 (D-064)
#   meta: !!omap
#   - {ucd: phys.acceleration}
# - name: g_bar_err_lo
#   unit: m / s2
#   datatype: float64
#   description: From the stellar-mass error only, at fixed R_E
#   meta: !!omap
#   - {ucd: stat.error;phys.acceleration}
# - name: g_bar_err_hi
#   unit: m / s2
#   datatype: float64
#   description: From the stellar-mass error only, at fixed R_E
#   meta: !!omap
#   - {ucd: stat.error;phys.acceleration}
# - name: g_bar_stars
#   unit: m / s2
#   datatype: float64
#   description: Stars inside the cylinder, default IMF
#   meta: !!omap
#   - {ucd: phys.acceleration}
# - name: g_bar_gas_cold
#   unit: m / s2
#   datatype: float64
#   description: Cold gas inside the cylinder (registered gas term, D-076 item 1)
#   meta: !!omap
#   - {ucd: phys.acceleration}
# - name: g_bar_gas_hot
#   unit: m / s2
#   datatype: float64
#   description: Hot gas inside the cylinder (registered gas term, D-076 item 1)
#   meta: !!omap
#   - {ucd: phys.acceleration}
# - name: limit
#   datatype: string
#   description: none
#   meta: !!omap
#   - {ucd: meta.code}
# - name: stars_status
#   datatype: string
#   description: 'Stars: measured'
#   meta: !!omap
#   - {ucd: meta.code}
# - name: gas_cold_status
#   datatype: string
#   description: 'Cold gas: modelled from the registered gas term'
#   meta: !!omap
#   - {ucd: meta.code}
# - name: gas_hot_status
#   datatype: string
#   description: 'Hot gas: modelled from the registered gas term'
#   meta: !!omap
#   - {ucd: meta.code}
# - name: observed_from
#   datatype: string
#   description: Observable IDs feeding g_obs
#   meta: !!omap
#   - {ucd: meta.ref}
# - name: baryonic_from
#   datatype: string
#   description: Observable IDs feeding g_bar (including the IMF top where used)
#   meta: !!omap
#   - {ucd: meta.ref}
# - name: model_dependence
#   datatype: string
#   description: total_mass_form where R_E is half the image separation (D-063 item 2)
#   meta: !!omap
#   - {ucd: meta.code}
# - name: evidence_tier
#   datatype: int64
#   description: Highest (weakest) tier among the inputs (D-035)
#   meta: !!omap
#   - {ucd: meta.code.qual}
# - name: role
#   datatype: string
#   description: default or alternative
#   meta: !!omap
#   - {ucd: meta.code}
# - name: alternative_of
#   datatype: string
#   description: Default measurement this row is an alternative to
#   meta: !!omap
#   - {ucd: meta.id}
# - name: plotted
#   datatype: string
#   description: Plotted in the default view
#   meta: !!omap
#   - {ucd: meta.code}
# - name: not_plotted_reason
#   datatype: string
#   description: Why not plotted
#   meta: !!omap
#   - {ucd: meta.note}
# - name: assumptions
#   datatype: string
#   description: Registered assumptions (data/assumptions.json)
#   meta: !!omap
#   - {ucd: meta.note}
# - name: adjustable
#   datatype: string
#   description: Assumptions with a slider on this row
#   meta: !!omap
#   - {ucd: meta.note}
# - name: flags
#   datatype: string
#   description: "Core flags (data standard \xA711)"
#   meta: !!omap
#   - {ucd: meta.code}
# - name: source_ref
#   datatype: string
#   description: Default observed and stellar-mass records (inventory R numbers)
#   meta: !!omap
#   - {ucd: meta.ref}
# - name: notes
#   datatype: string
#   description: Reasons not plotted, or what the alternative replaces
#   meta: !!omap
#   - {ucd: meta.note}
# - name: x_strong_lensing_projection
#   datatype: string
#   description: projected (D-064)
#   meta: !!omap
#   - {ucd: meta.code}
# - name: x_strong_lensing_scope
#   datatype: string
#   description: Inventory scope (survey)
#   meta: !!omap
#   - {ucd: meta.note}
# - name: x_strong_lensing_flags
#   datatype: string
#   description: Package flags (D-075, D-076), space-separated
#   meta: !!omap
#   - {ucd: meta.code}
# - name: x_strong_lensing_theta_e_arcsec
#   unit: arcsec
#   datatype: float64
#   description: Einstein radius (or aperture taken as R_E)
#   meta: !!omap
#   - {ucd: phys.angSize}
# - name: x_strong_lensing_z_l
#   datatype: float64
#   description: Lens redshift used
#   meta: !!omap
#   - {ucd: src.redshift}
# - name: x_strong_lensing_z_s
#   datatype: float64
#   description: Source redshift used
#   meta: !!omap
#   - {ucd: src.redshift}
# - name: x_strong_lensing_h0
#   unit: km / (Mpc s)
#   datatype: float64
#   description: Source's H0
#   meta: !!omap
#   - {ucd: phys.veloc.expansion}
# - name: x_strong_lensing_om
#   datatype: float64
#   description: Source's Omega_m (flat)
#   meta: !!omap
#   - {ucd: meta.number}
# - name: x_strong_lensing_m_e_msun
#   unit: solMass
#   datatype: float64
#   description: Projected mass inside R_E
#   meta: !!omap
#   - {ucd: phys.mass}
# - name: x_strong_lensing_m_e_source
#   datatype: string
#   description: "printed or computed (A6S_PRECEDENCE \xA72.4)"
#   meta: !!omap
#   - {ucd: meta.code}
# - name: x_strong_lensing_r_e_source
#   datatype: string
#   description: printed (kpc, R32) or computed
#   meta: !!omap
#   - {ucd: meta.code}
# - name: x_strong_lensing_mstar_route
#   datatype: string
#   description: printed_in_RE, L_times_ML or profile
#   meta: !!omap
#   - {ucd: meta.code}
# - name: x_strong_lensing_mstar_msun
#   unit: solMass
#   datatype: float64
#   description: Stellar mass as printed (inside R_E or total) or L x M/L
#   meta: !!omap
#   - {ucd: phys.mass}
# - name: x_strong_lensing_l_aperture_lsun
#   unit: solLum
#   datatype: float64
#   description: Luminosity inside R_E (band in observables)
#   meta: !!omap
#   - {ucd: phys.luminosity}
# - name: x_strong_lensing_ml
#   unit: solMass / solLum
#   datatype: float64
#   description: Population M/L (named IMF)
#   meta: !!omap
#   - {ucd: phys.composition.massLightRatio}
# - name: x_strong_lensing_r_eff_arcsec
#   unit: arcsec
#   datatype: float64
#   description: Source's light-profile effective radius
#   meta: !!omap
#   - {ucd: phys.angSize}
# - name: x_strong_lensing_sersic_n
#   datatype: float64
#   description: Sersic index of the source's light profile (4 = de Vaucouleurs)
#   meta: !!omap
#   - {ucd: meta.number}
# - name: x_strong_lensing_profile_fraction
#   datatype: float64
#   description: f(<R_E) from the source's light profile
#   meta: !!omap
#   - {ucd: arith.factor}
# - name: x_strong_lensing_mstar_re_msun
#   unit: solMass
#   datatype: float64
#   description: Stellar mass inside R_E at the default IMF
#   meta: !!omap
#   - {ucd: phys.mass}
# - name: x_strong_lensing_mstar_top_msun
#   unit: solMass
#   datatype: float64
#   description: Salpeter stellar mass inside R_E (IMF slider top); empty where not read
#   meta: !!omap
#   - {ucd: phys.mass}
# - name: x_strong_lensing_mstar_top_source
#   datatype: string
#   description: Where the Salpeter top comes from
#   meta: !!omap
#   - {ucd: meta.ref}
# - name: x_strong_lensing_gas_term
#   datatype: string
#   description: Registered gas term and its ruling
#   meta: !!omap
#   - {ucd: meta.ref}
# - name: x_strong_lensing_gas_statement
#   datatype: string
#   description: The source's own gas statement, where it makes one
#   meta: !!omap
#   - {ucd: meta.note}
# - name: x_strong_lensing_gas_cold_frac
#   datatype: float64
#   description: Cold gas as a fraction of M*(<R_E), default
#   meta: !!omap
#   - {ucd: arith.factor}
# - name: x_strong_lensing_gas_cold_frac_min
#   datatype: float64
#   description: Cold gas fraction, registered minimum
#   meta: !!omap
#   - {ucd: arith.factor}
# - name: x_strong_lensing_gas_cold_frac_max
#   datatype: float64
#   description: Cold gas fraction, registered maximum
#   meta: !!omap
#   - {ucd: arith.factor}
# - name: x_strong_lensing_gas_hot_frac
#   datatype: float64
#   description: Hot gas as a fraction of M*(<R_E), default
#   meta: !!omap
#   - {ucd: arith.factor}
# - name: x_strong_lensing_gas_hot_frac_min
#   datatype: float64
#   description: Hot gas fraction, registered minimum
#   meta: !!omap
#   - {ucd: arith.factor}
# - name: x_strong_lensing_gas_hot_frac_max
#   datatype: float64
#   description: Hot gas fraction, registered maximum
#   meta: !!omap
#   - {ucd: arith.factor}
