# %ECSV 1.0
# ---
# datatype:
# - name: system_id
#   datatype: string
#   description: Atlas system identifier
#   meta: !!omap
#   - {ucd: meta.id;meta.main}
# - name: name_in_source
#   datatype: string
#   description: Name as in the LVDB index
#   meta: !!omap
#   - {ucd: meta.id}
# - name: class_in_source
#   datatype: string
#   description: Class as the source gives it
#   meta: !!omap
#   - {ucd: src.class}
# - name: taxonomy_kind
#   datatype: string
#   description: Taxonomy kind (D-048, D-049)
#   meta: !!omap
#   - {ucd: meta.code}
# - name: kind_label
#   datatype: string
#   description: Kind label
#   meta: !!omap
#   - {ucd: meta.note}
# - name: host
#   datatype: string
#   description: Host (property, never a filter)
#   meta: !!omap
#   - {ucd: meta.id}
# - name: ra_deg
#   unit: deg
#   datatype: float64
#   description: Right ascension (J2000), LVDB
#   meta: !!omap
#   - {ucd: pos.eq.ra;meta.main}
# - name: dec_deg
#   unit: deg
#   datatype: float64
#   description: Declination (J2000), LVDB
#   meta: !!omap
#   - {ucd: pos.eq.dec;meta.main}
# - name: distance_mpc
#   unit: Mpc
#   datatype: float64
#   description: Package distance
#   meta: !!omap
#   - {ucd: pos.distance}
# - name: distance_method
#   datatype: string
#   description: Distance method
#   meta: !!omap
#   - {ucd: meta.note}
# - name: distance_kinematic
#   datatype: string
#   description: Distance derived from kinematics
#   meta: !!omap
#   - {ucd: meta.code}
# - name: distance_ref
#   datatype: string
#   description: Distance source
#   meta: !!omap
#   - {ucd: meta.ref}
# - name: metallicity_feh
#   datatype: float64
#   description: '[Fe/H] (D-057, D-059)'
#   meta: !!omap
#   - {ucd: phys.abund.Fe}
# - name: properties
#   datatype: string
#   description: Status, reasons and flags (JSON)
#   meta: !!omap
#   - {ucd: meta.note}
# delimiter: ','
# meta: !!omap
# - {dataset: aeg-d-dwarfs}
# - {version: v1}
# - {standard_version: 2.0.0}
# schema: astropy-2.0
