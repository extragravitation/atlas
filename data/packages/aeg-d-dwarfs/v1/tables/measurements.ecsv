# %ECSV 1.0
# ---
# datatype:
# - name: measurement_id
#   datatype: string
#   description: Permanent measurement identifier
#   meta: !!omap
#   - {ucd: meta.id;meta.main}
# - name: system_id
#   datatype: string
#   description: Atlas system identifier
#   meta: !!omap
#   - {ucd: meta.id}
# - name: kind
#   datatype: string
#   description: Kind of measurement
#   meta: !!omap
#   - {ucd: meta.code}
# - name: channel
#   datatype: string
#   description: Observational channel
#   meta: !!omap
#   - {ucd: meta.code}
# - name: method_class
#   datatype: string
#   description: Class of method
#   meta: !!omap
#   - {ucd: meta.code.class}
# - name: method
#   datatype: string
#   description: Method
#   meta: !!omap
#   - {ucd: meta.note}
# - name: measured_quantity
#   datatype: string
#   description: Quantity measured (D-029)
#   meta: !!omap
#   - {ucd: meta.code}
# - name: r_kpc
#   unit: kpc
#   datatype: float64
#   description: "Three-dimensional half-light radius r\xBD = 4/3 R_h"
#   meta: !!omap
#   - {ucd: phys.size.radius}
# - name: r_kind
#   datatype: string
#   description: Radius is three-dimensional
#   meta: !!omap
#   - {ucd: meta.code}
# - name: g_obs
#   unit: m / s2
#   datatype: float64
#   description: "Observed acceleration at r\xBD, 3 \u03C3\xB2 / r\xBD (D-025); an upper limit where limit = upper"
#   meta: !!omap
#   - {ucd: phys.acceleration}
# - name: g_obs_err_lo
#   unit: m / s2
#   datatype: float64
#   description: From the dispersion's printed lower error only
#   meta: !!omap
#   - {ucd: stat.error;phys.acceleration}
# - name: g_obs_err_hi
#   unit: m / s2
#   datatype: float64
#   description: From the dispersion's printed upper error only
#   meta: !!omap
#   - {ucd: stat.error;phys.acceleration}
# - name: g_bar
#   unit: m / s2
#   datatype: float64
#   description: "Baryonic acceleration at r\xBD, G (L_V \u03A5_V / 2 + M_gas(<r\xBD)) / r\xBD\xB2 (D-025)"
#   meta: !!omap
#   - {ucd: phys.acceleration}
# - name: g_bar_err_lo
#   unit: m / s2
#   datatype: float64
#   description: From the magnitude error only (stars)
#   meta: !!omap
#   - {ucd: stat.error;phys.acceleration}
# - name: g_bar_err_hi
#   unit: m / s2
#   datatype: float64
#   description: From the magnitude error only (stars)
#   meta: !!omap
#   - {ucd: stat.error;phys.acceleration}
# - name: g_bar_stars
#   unit: m / s2
#   datatype: float64
#   description: Stellar component of g_bar
#   meta: !!omap
#   - {ucd: phys.acceleration}
# - name: g_bar_gas_cold
#   unit: m / s2
#   datatype: float64
#   description: "Atomic gas with helium (1.33 M_HI), half the total inside r\xBD (D-058); 0 where absent"
#   meta: !!omap
#   - {ucd: phys.acceleration}
# - name: limit
#   datatype: string
#   description: Whether g_obs is a limit
#   meta: !!omap
#   - {ucd: meta.code}
# - name: stars_status
#   datatype: string
#   description: Stars measured (starlight with population M/L)
#   meta: !!omap
#   - {ucd: meta.code}
# - name: gas_cold_status
#   datatype: string
#   description: "Atomic gas: measured (Putman et al. 2021 detection) or absent (5\u03C3 limit, or not addressed); see x_dwarfs_gas_status"
#   meta: !!omap
#   - {ucd: meta.code}
# - name: gas_hot_status
#   datatype: string
#   description: Hot gas not included (not addressed by the sources)
#   meta: !!omap
#   - {ucd: meta.code}
# - name: observed_from
#   datatype: string
#   description: Observables used on the observed side
#   meta: !!omap
#   - {ucd: meta.ref}
# - name: baryonic_from
#   datatype: string
#   description: Observables used on the baryonic side
#   meta: !!omap
#   - {ucd: meta.ref}
# - name: model_dependence
#   datatype: string
#   description: No fitted form on the observed side
#   meta: !!omap
#   - {ucd: meta.code}
# - name: evidence_tier
#   datatype: int64
#   description: Evidence tier (D-035)
#   meta: !!omap
#   - {ucd: meta.code.qual}
# - name: role
#   datatype: string
#   description: Default value for the system
#   meta: !!omap
#   - {ucd: meta.code}
# - name: plotted
#   datatype: string
#   description: Shown in default views
#   meta: !!omap
#   - {ucd: meta.code}
# - name: not_plotted_reason
#   datatype: string
#   description: Why not plotted (closed list)
#   meta: !!omap
#   - {ucd: meta.note}
# - name: assumptions
#   datatype: string
#   description: Named assumptions affecting this row
#   meta: !!omap
#   - {ucd: meta.note}
# - name: adjustable
#   datatype: string
#   description: Assumptions whose sliders can change this row
#   meta: !!omap
#   - {ucd: meta.note}
# - name: flags
#   datatype: string
#   description: Atlas flags
#   meta: !!omap
#   - {ucd: meta.code}
# - name: source_ref
#   datatype: string
#   description: 'Originals: dispersion; structure; distance; magnitude'
#   meta: !!omap
#   - {ucd: meta.ref}
# - name: notes
#   datatype: string
#   description: Notes
#   meta: !!omap
#   - {ucd: meta.note}
# - name: x_dwarfs_flags
#   datatype: string
#   description: 'Package flags: how each input was chosen (rulings in docs/decisions.md)'
#   meta: !!omap
#   - {ucd: meta.code}
# - name: x_dwarfs_sigma
#   unit: km / s
#   datatype: float64
#   description: Published line-of-sight dispersion (or its upper limit)
#   meta: !!omap
#   - {ucd: phys.veloc.dispersion}
# - name: x_dwarfs_sigma_err_lo
#   unit: km / s
#   datatype: float64
#   description: Printed lower error
#   meta: !!omap
#   - {ucd: stat.error;phys.veloc.dispersion}
# - name: x_dwarfs_sigma_err_hi
#   unit: km / s
#   datatype: float64
#   description: Printed upper error
#   meta: !!omap
#   - {ucd: stat.error;phys.veloc.dispersion}
# - name: x_dwarfs_sigma_limit_level
#   datatype: string
#   description: Confidence level of an upper limit, as stated
#   meta: !!omap
#   - {ucd: meta.note}
# - name: x_dwarfs_R_h_arcmin
#   unit: arcmin
#   datatype: float64
#   description: Circularised projected half-light radius
#   meta: !!omap
#   - {ucd: phys.angSize}
# - name: x_dwarfs_distance_kpc
#   unit: kpc
#   datatype: float64
#   description: Package distance
#   meta: !!omap
#   - {ucd: pos.distance}
# - name: x_dwarfs_l_v
#   unit: solLum
#   datatype: float64
#   description: V-band luminosity at the package distance, M_V,sun = 4.85
#   meta: !!omap
#   - {ucd: phys.luminosity}
# - name: x_dwarfs_upsilon_v
#   unit: solMass / solLum
#   datatype: float64
#   description: "Population \u03A5_V default (D-059)"
#   meta: !!omap
#   - {ucd: phys.composition.massLightRatio}
# - name: x_dwarfs_upsilon_v_low
#   unit: solMass / solLum
#   datatype: float64
#   description: D-060 lower bound
#   meta: !!omap
#   - {ucd: phys.composition.massLightRatio}
# - name: x_dwarfs_upsilon_v_high
#   unit: solMass / solLum
#   datatype: float64
#   description: D-060 upper bound
#   meta: !!omap
#   - {ucd: phys.composition.massLightRatio}
# - name: x_dwarfs_m_gas_rh
#   unit: solMass
#   datatype: float64
#   description: "Gas mass inside r\xBD (1.33 \xD7 half the rescaled HI mass), 0 where absent"
#   meta: !!omap
#   - {ucd: phys.mass}
# - name: x_dwarfs_gas_status
#   datatype: string
#   description: measured, absent (measured limit) or not addressed (D-035 d)
#   meta: !!omap
#   - {ucd: meta.code}
# delimiter: ','
# meta: !!omap
# - {dataset: aeg-d-dwarfs}
# - {version: v1}
# - {standard_version: 2.0.0}
