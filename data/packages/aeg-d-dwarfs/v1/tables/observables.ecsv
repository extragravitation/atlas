# %ECSV 1.0
# ---
# datatype:
# - name: observable_id
#   datatype: string
#   description: Permanent observable identifier
#   meta: !!omap
#   - {ucd: meta.id;meta.main}
# - name: system_id
#   datatype: string
#   description: Atlas system identifier
#   meta: !!omap
#   - {ucd: meta.id}
# - name: side
#   datatype: string
#   description: Observed or baryonic side
#   meta: !!omap
#   - {ucd: meta.code}
# - name: quantity
#   datatype: string
#   description: Quantity (closed list, data standard 2.0)
#   meta: !!omap
#   - {ucd: meta.code}
# - name: value
#   datatype: float64
#   description: Value (as printed, or as converted where x_dwarfs_parameter says)
#   meta: !!omap
#   - {ucd: meta.number}
# - name: err_lo
#   datatype: float64
#   description: Lower error
#   meta: !!omap
#   - {ucd: stat.error}
# - name: err_hi
#   datatype: float64
#   description: Upper error
#   meta: !!omap
#   - {ucd: stat.error}
# - name: unit
#   datatype: string
#   description: Unit of value
#   meta: !!omap
#   - {ucd: meta.unit}
# - name: band
#   datatype: string
#   description: Photometric band
#   meta: !!omap
#   - {ucd: instr.bandpass}
# - name: limit
#   datatype: string
#   description: Whether the value is a limit
#   meta: !!omap
#   - {ucd: meta.code}
# - name: steps
#   datatype: string
#   description: Processing ladder from data to this quantity
#   meta: !!omap
#   - {ucd: meta.note}
# - name: evidence_tier
#   datatype: int64
#   description: Evidence tier (D-035)
#   meta: !!omap
#   - {ucd: meta.code.qual}
# - name: source_ref
#   datatype: string
#   description: Source and location
#   meta: !!omap
#   - {ucd: meta.ref}
# - name: x_dwarfs_parameter
#   datatype: string
#   description: Which value this row is
#   meta: !!omap
#   - {ucd: meta.note}
# delimiter: ','
# meta: !!omap
# - {dataset: aeg-d-dwarfs}
# - {version: v1}
# - {standard_version: 2.0.0}
# schema: astropy-2.0
