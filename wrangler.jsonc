// Cloudflare Workers configuration (decision D-007, amended 2026-10-28).
// Static assets only: no server code runs. Cloudflare serves the built site in site/dist.
// The site is built by wrangler's custom build before every deploy or preview upload,
// so no build command is needed in the Cloudflare dashboard (leave it empty there).
{
  "name": "extragravitation",
  "compatibility_date": "2026-10-28",
  "build": {
    "command": "cd site && npm ci && npm run build"
  },
  "assets": {
    "directory": "./site/dist",
    "not_found_handling": "404-page"
  },
  // Required by Workers Builds preview builds (one preview per branch and pull request).
  "previews": {}
}
